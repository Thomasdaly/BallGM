<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BallGM.Application\BallGM.Application.csproj" />
    <!-- Composition root only: Program.cs picks the concrete ILeagueDataSource. Views and view
         models must stay on Application types - enforced by ArchitectureBoundaryTests. -->
    <ProjectReference Include="..\BallGM.Infrastructure\BallGM.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <!-- Debug builds only: lets Avalonia Developer Tools (and its MCP server, `avdt mcp`) attach to
       the running client. Never shipped in a Release build. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

</Project>
