<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BallGM.Application\BallGM.Application.csproj" />
    <!-- Composition root only: Program.cs picks the concrete ILeagueDataSource. Views and view
         models must stay on Application types - enforced by ArchitectureBoundaryTests. -->
    <ProjectReference Include="..\BallGM.Infrastructure\BallGM.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
  </ItemGroup>

  <!-- Embedded typefaces (Barlow, SIL OFL 1.1 - licence in Assets/Fonts/OFL.txt). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BallGM.Client.Avalonia.Tests" />
  </ItemGroup>

  <!-- Developer tooling: lets Avalonia Developer Tools (`avdt mcp`) and the Zafiro Avalonia MCP
       server attach to a running client. Only Debug builds call into them (App.axaml.cs and
       Program.cs, under #if DEBUG).

       Referenced unconditionally on purpose: NuGet restore does not see the build configuration,
       so a Configuration-conditioned PackageReference made the restore depend on which command ran
       first — and CI's configuration-less restore put them in Release builds anyway. Publish="false"
       is what keeps them, and Zafiro's Roslyn dependency, out of published (shipped) output. -->
  <ItemGroup>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Publish="false" />
    <PackageReference Include="Zafiro.Avalonia.Mcp.AppHost" Publish="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

</Project>
