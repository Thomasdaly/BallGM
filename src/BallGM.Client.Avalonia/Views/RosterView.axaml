<UserControl
  x:Class="BallGM.Client.Avalonia.Views.RosterView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  x:DataType="vm:RosterViewModel">
  <!-- S07 Roster, template T2: summary tiles, sub-tabs, filter bar, data table. -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,2*,*,*" ColumnSpacing="{StaticResource Space16}" Margin="{StaticResource GapBottom16}">
      <ctl:Tile Classes="compact">
        <ctl:StatTile Value="{Binding AverageOverall}" Label="Average overall" />
      </ctl:Tile>
      <ctl:Tile Grid.Column="1" Classes="compact">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space12}">
          <ctl:PlayerHeadshot PlayerId="{Binding TopPlayerId}" PlayerName="{Binding TopPlayerName}" Size="Medium" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Space4}">
            <TextBlock Text="TOP PLAYER" Classes="label-caps" />
            <ctl:EntityLink Text="{Binding TopPlayerName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Kind="Player" EntityId="{Binding TopPlayerId}" Command="{Binding OpenTopPlayerCommand}" CommandParameter="{Binding TopPlayerId}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="{StaticResource FontSizeH3}" />
          </StackPanel>
          <ctl:RatingBadge Grid.Column="2" Value="{Binding TopPlayerOverall}" Size="Large" VerticalAlignment="Center" />
        </Grid>
      </ctl:Tile>
      <ctl:Tile Grid.Column="2" Classes="compact">
        <ctl:StatTile Value="{Binding InjuredCount}" Label="Injured" />
      </ctl:Tile>
      <ctl:Tile Grid.Column="3" Classes="compact">
        <StackPanel Spacing="{StaticResource Space4}">
          <ctl:StatTile Value="{Binding Payroll}" Label="Payroll" />
          <TextBlock Text="{Binding RosterCountLabel}" Classes="caption wrap" ToolTip.Tip="{Binding RosterCountLabel}" />
        </StackPanel>
      </ctl:Tile>
    </Grid>

    <DockPanel DockPanel.Dock="Top" Margin="{StaticResource GapBottom12}">
      <ctl:SegmentedControl DockPanel.Dock="Right" ItemsSource="{Binding LayoutOptions}" SelectedIndex="{Binding LayoutIndex}" VerticalAlignment="Center" AutomationProperties.Name="Table or cards" />
      <ctl:SkewTabStrip ItemsSource="{Binding Tabs}" SelectedIndex="{Binding TabIndex}" />
    </DockPanel>

    <ctl:FilterBar DockPanel.Dock="Top" SearchText="{Binding SearchText}" SearchPlaceholder="Search roster" ActiveCount="{Binding ActiveFilterCount}" ResetCommand="{Binding ResetFiltersCommand}" Margin="{StaticResource GapBottom12}">
      <WrapPanel ItemSpacing="{StaticResource Space16}" LineSpacing="{StaticResource Space8}">
        <ItemsControl ItemsSource="{Binding PositionFilters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChipFilter">
              <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ctl:RangeFilter Label="OVR" Minimum="0" Maximum="100" Low="{Binding OverallLow}" High="{Binding OverallHigh}" />
        <ctl:RangeFilter Label="AGE" Minimum="16" Maximum="45" Low="{Binding AgeLow}" High="{Binding AgeHigh}" />
        <ItemsControl ItemsSource="{Binding StatusFilters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChipFilter">
              <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ctl:SegmentedControl ItemsSource="{Binding BasisOptions}" SelectedIndex="{Binding BasisIndex}" IsVisible="{Binding IsStatsTab}" AutomationProperties.Name="Stat basis" />
      </WrapPanel>
    </ctl:FilterBar>

    <!-- Cards: the same filtered players as player cards. -->
    <ScrollViewer DockPanel.Dock="Bottom" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsCardLayout}">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="{StaticResource Space16}" LineSpacing="{StaticResource Space16}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ctl:PlayerCardModel">
            <ctl:PlayerCard Model="{Binding}" Width="440" OpenCommand="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).OpenCardCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ctl:DataTable
      IsVisible="{Binding IsTableLayout}"
      Columns="{Binding TableColumns}"
      Rows="{Binding TableRows}"
      SortKey="{Binding TableSortKey}"
      SortDescending="{Binding TableSortDescending}"
      SortCommand="{Binding TableSortCommand}"
      OpenRowCommand="{Binding OpenRowCommand}"
      EmptyHeadline="No players match"
      EmptyMessage="Nobody on this roster fits these filters."
      EmptyActionText="Clear filters"
      EmptyActionCommand="{Binding ResetFiltersCommand}" />
  </DockPanel>
</UserControl>
