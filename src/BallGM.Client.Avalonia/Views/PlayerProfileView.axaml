<UserControl
  x:Class="BallGM.Client.Avalonia.Views.PlayerProfileView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  xmlns:views="clr-namespace:BallGM.Client.Avalonia.Views"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls"
  x:DataType="vm:PlayerProfileViewModel">
  <UserControl.Resources>
    <!-- A game log's header and rows, for recent form and the full game log alike. -->
    <DataTemplate x:Key="GameLogHeaderTemplate" x:DataType="vm:PlayerProfileViewModel">
      <Grid Classes="thead" ColumnDefinitions="64,*,96,50,Auto">
        <TextBlock Text="Date" />
        <TextBlock Grid.Column="1" Text="Opponent" MinWidth="{StaticResource TableNameMinWidth}" />
        <TextBlock Grid.Column="2" Text="Result" />
        <TextBlock Grid.Column="3" Text="RTG" HorizontalAlignment="Center" ToolTip.Tip="Match rating out of ten. Open one for how it was built." />
        <ItemsControl Grid.Column="4" Classes="statheads" ItemsSource="{Binding GameLogHeaders}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GameRowTemplate" x:DataType="vm:RecentGameRow">
      <Grid ColumnDefinitions="64,*,96,50,Auto" Height="30">
        <TextBlock Text="{Binding Date}" Classes="dim small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Opponent}" Classes="strong small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding Result}" Classes="num small" Classes.good="{Binding Won}" Classes.bad="{Binding !Won}" VerticalAlignment="Center" />
        <views:RatingPill Grid.Column="3" DataContext="{Binding Rating}" />
        <ItemsControl Grid.Column="4" Classes="statrow" ItemsSource="{Binding Stats}" />
      </Grid>
    </DataTemplate>
    <!-- One titled panel of stat tiles, for the simulated and the stated season alike. -->
    <DataTemplate x:Key="StatGroupTemplate" x:DataType="vm:StatGroup">
      <Border Classes="panel" Margin="0,0,0,14">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Title}" Classes="section" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}" Classes="faint tiny" VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatCell">
                <Border Classes="stat" MinWidth="104" Padding="12,8" ToolTip.Tip="{Binding Definition}" AutomationProperties.Name="{Binding AccessibleName}">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                    <TextBlock Text="{Binding Value}" Classes="num statvalue" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Spacing="18">
      <Button Content="{Binding BackLabel}" Command="{Binding BackCommand}" HorizontalAlignment="Left" />

      <!-- Identity: portrait, name, rating, bio. -->
      <Border Classes="panel">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
          <Border Classes="face" Width="104" Height="104" CornerRadius="52">
            <Image Source="{Binding PortraitPath, Converter={x:Static conv:ImagePathConverter.Instance}}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="pill">
                <TextBlock Text="{Binding Position}" />
              </Border>
              <TextBlock Text="{Binding TeamLine}" Classes="eyebrow accent" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding FullName}" Classes="display" />
            <TextBlock Text="{Binding BioLine}" Classes="dim" />
            <Border Classes="pill bad" IsVisible="{Binding IsInjured}">
              <TextBlock Text="{Binding InjuryDescription}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space5}" VerticalAlignment="Center" HorizontalAlignment="Right">
          <!-- The season's average match rating and its last ten games, the line always beside its figures. -->
          <StackPanel Spacing="4" VerticalAlignment="Center" IsVisible="{Binding SeasonRating, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Season rating" Classes="eyebrow" HorizontalAlignment="Center" />
            <views:RatingPill DataContext="{Binding SeasonRating}" HorizontalAlignment="Center" />
            <ctl:Sparkline Values="{Binding RatingTrend}" Width="128" Height="40" IsVisible="{Binding HasRatingTrend}"
                           ToolTip.Tip="{Binding RatingTrendText, StringFormat='Last games, oldest first: {0}'}"
                           AutomationProperties.Name="{Binding RatingTrendText, StringFormat='Match ratings, last games oldest first: {0}'}" />
            <TextBlock Text="{Binding RatingTrendCaption}" Classes="faint tiny" HorizontalAlignment="Center" IsVisible="{Binding HasRatingTrend}" />
          </StackPanel>
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Overall" Classes="eyebrow" HorizontalAlignment="Center" />
            <Border Classes="ovr" Width="84" Height="56" CornerRadius="6" Background="{Binding Overall, Converter={x:Static conv:OverallTierConverter.Instance}}">
              <TextBlock Classes="size-h1" Text="{Binding Overall}" />
            </Border>
          </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Classes="profile">
        <TabItem Header="Overview">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="18" Margin="0,14,0,0">
            <StackPanel Spacing="18">
          <!-- The scouting report: ability as a coach's stars, personality, body, positions, traits. -->
          <Border Classes="panel" DataContext="{Binding Sheet}">
            <StackPanel Spacing="12">
              <TextBlock Text="Scouting report" Classes="section" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="6">
                <TextBlock Text="Current" Classes="dim small" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentStars}" Classes="stars" AutomationProperties.Name="{Binding CurrentStarsName}" ToolTip.Tip="{Binding CurrentStarsName}" />
                <TextBlock Grid.Row="1" Text="Potential" Classes="dim small" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PotentialStars}" Classes="stars" AutomationProperties.Name="{Binding PotentialStarsName}" ToolTip.Tip="{Binding PotentialStarsName}" />
                <TextBlock Grid.Row="2" Text="Personality" Classes="dim small" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Personality}" Classes="strong" />
              </Grid>
              <TextBlock Text="Current ability is the Overall in the header, weighted across the Attributes tab." Classes="faint tiny" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Body}" Classes="small figures" TextWrapping="Wrap" IsVisible="{Binding HasBody}" />
              <StackPanel Spacing="4">
                <TextBlock Text="Positions" Classes="dim small" />
                <ItemsControl ItemsSource="{Binding Positions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PositionChip">
                      <Border Classes="poschip" Classes.natural="{Binding IsNatural}" Classes.accomplished="{Binding IsAccomplished}" Classes.competent="{Binding IsCompetent}"
                              ToolTip.Tip="{Binding AccessibleName}" AutomationProperties.Name="{Binding AccessibleName}">
                        <StackPanel HorizontalAlignment="Center">
                          <TextBlock Text="{Binding Position}" Classes="strong small" HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding Familiarity}" Classes="tiny" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding HasTraits}">
                <TextBlock Text="Traits" Classes="dim small" />
                <ItemsControl ItemsSource="{Binding Traits}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="pill">
                        <TextBlock Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="18">
          <StackPanel Spacing="8">
            <TextBlock Text="This season" Classes="section" />
            <TextBlock Text="No games played this season yet." Classes="faint small" IsVisible="{Binding !HasSeason}" />
            <ItemsControl ItemsSource="{Binding SeasonTiles}" IsVisible="{Binding HasSeason}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatTile">
                  <Border Classes="stat" MinWidth="88">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                      <TextBlock Text="{Binding Value}" Classes="value" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>


            </StackPanel>
          <!-- Full width: a game log carries the whole box-score line and needs the room. -->
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="Recent form" Classes="section" />
            <TextBlock Text="Form appears once this player has played in a simulated game." Classes="faint small" IsVisible="{Binding !HasRecentGames}" />
            <ScrollViewer Classes="tablewrap" IsVisible="{Binding HasRecentGames}">
              <StackPanel Spacing="4">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameLogHeaderTemplate}" />
                <ItemsControl Classes="table" ItemsSource="{Binding RecentGames}" ItemTemplate="{StaticResource GameRowTemplate}" />
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Attributes">
          <!-- The full sheet, grouped as a scout reads it; every value printed, its badge tint only repeats the tier. -->
          <ItemsControl ItemsSource="{Binding Sheet.Columns}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <ItemsControl ItemsSource="{Binding}" Margin="0,0,18,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttributeGroupView">
                      <Border Classes="panel" Margin="0,0,0,14">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" Classes="section" Margin="0,0,0,4" />
                          <ItemsControl ItemsSource="{Binding Attributes}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AttributeCell">
                                <Grid ColumnDefinitions="*,42" Height="28" ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding AccessibleName}">
                                  <TextBlock Text="{Binding Name}" Classes="small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  <Border Grid.Column="1" Classes="ovr small" Background="{Binding Value, Converter={x:Static conv:OverallTierConverter.Instance}}">
                                    <TextBlock Text="{Binding Value}" />
                                  </Border>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </TabItem>

        <TabItem Header="Stats">
          <StackPanel Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="This season, simulated" Classes="section" />
            <TextBlock Text="No games played this season yet. Start or advance the season on the Calendar." Classes="faint small" IsVisible="{Binding !HasSimulatedStats}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" Margin="0,0,0,6" IsVisible="{Binding HasSimulatedStats}">
              <views:BasisToggle DataContext="{Binding Basis}" />
              <TextBlock Text="{Binding SimulatedSample}" Classes="faint small" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SimulatedGroups}" ItemTemplate="{StaticResource StatGroupTemplate}" />
            <!-- Against the league: a percentile per stat, the figure printed beside every bar. -->
            <Border Classes="panel" Margin="0,0,0,14" IsVisible="{Binding HasSimulatedStats}">
              <StackPanel Spacing="{StaticResource Space3}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Against the league" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Text="Percentile among qualified players this regular season, per game. Higher is better on every row." Classes="faint tiny" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding NotRankedNote}" Classes="faint small" IsVisible="{Binding !HasPercentiles}" />
                <ItemsControl ItemsSource="{Binding Percentiles}" IsVisible="{Binding HasPercentiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource Space5}" LineSpacing="{StaticResource Space2}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PercentileRow">
                      <Grid ColumnDefinitions="44,140,44" ColumnSpacing="{StaticResource Space2}" ToolTip.Tip="{Binding Tooltip}"
                            AutomationProperties.Name="{Binding AccessibleName}">
                        <TextBlock Text="{Binding Stat}" Classes="small strong" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Classes="percentile" Minimum="0" Maximum="100" Value="{Binding Percentile}"
                                     AutomationProperties.Name="{Binding AccessibleName}" />
                        <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="num small" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- Shooting by zone: the chart, its legend in words, and the same figures as a table. -->
            <Border Classes="panel" Margin="0,0,0,14" IsVisible="{Binding HasShotChart}">
              <StackPanel Spacing="{StaticResource Space3}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Shooting by zone" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Text="Field-goal percentage by zone, compared with the league from the same spot" Classes="faint tiny" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space5}">
                  <ctl:ShotChart Zones="{Binding ShotChart.Zones}" Width="460" VerticalAlignment="Top"
                                 AutomationProperties.Name="Shot chart: field-goal percentage by zone against the league. The same figures are in the table beside it." />
                  <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}">
                    <ItemsControl ItemsSource="{Binding ShotChart.Zones}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShotZoneCell">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,4" AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" Classes="small strong" />
                              <TextBlock Text="{Binding League, StringFormat='League {0}'}" Classes="faint tiny" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                              <TextBlock Text="{Binding Shooting}" Classes="num small" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding Difference}" Classes="faint tiny" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}" Margin="0,6,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource ChartCold2Brush}" />
                        <TextBlock Text="Colder than league" Classes="faint tiny" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource ChartNeutralBrush}" />
                        <TextBlock Text="{x:Static vm:ShotChartView.LevelLegend}" Classes="faint tiny" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource ChartHot2Brush}" />
                        <TextBlock Text="Hotter than league" Classes="faint tiny" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatedSeasonTitle}" Classes="eyebrow" IsVisible="{Binding HasStatedStats}" Margin="0,10,0,0" />
            <ItemsControl ItemsSource="{Binding StatedGroups}" ItemTemplate="{StaticResource StatGroupTemplate}" />
            <TextBlock Text="Hover any stat for its definition. Simulated rate stats use the player's share of team minutes, the standard box-score estimate." Classes="faint tiny" TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Game log">
          <StackPanel Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="This season's games" Classes="section" />
            <TextBlock Text="No games yet. The log fills in after this player's first simulated game this season." Classes="faint small" IsVisible="{Binding !HasGameLog}" />
            <ScrollViewer Classes="tablewrap" IsVisible="{Binding HasGameLog}">
              <StackPanel Spacing="4">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameLogHeaderTemplate}" />
                <ItemsControl Classes="table" ItemsSource="{Binding GameLog}" ItemTemplate="{StaticResource GameRowTemplate}" />
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </TabItem>

        <TabItem Header="Contract">
          <StackPanel Spacing="16" Margin="0,14,0,0">
            <TextBlock Text="{Binding ContractSummary}" Classes="h3" />
            <ItemsControl ItemsSource="{Binding ContractTiles}" IsVisible="{Binding HasContractDetail}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatTile">
                  <Border Classes="stat accent">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                      <TextBlock Text="{Binding Value}" Classes="value" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="panel" IsVisible="{Binding HasContractDetail}">
              <StackPanel Spacing="8">
                <TextBlock Text="Salary scale" Classes="section" />
                <Panel Width="360" Height="10" HorizontalAlignment="Left">
                  <Border Width="360" Height="10" CornerRadius="5" Background="{StaticResource Bg3Brush}" />
                  <Border Width="{Binding SalaryScaleFill}" Height="10" CornerRadius="5" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
                </Panel>
                <TextBlock Text="{Binding SalaryScaleLine}" Classes="dim small" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="4" IsVisible="{Binding HasContractDetail}">
              <Grid Classes="thead" ColumnDefinitions="100,140,140,140,*">
                <TextBlock Text="Season" />
                <TextBlock Grid.Column="1" Text="Salary" />
                <TextBlock Grid.Column="2" Text="Guaranteed" />
                <TextBlock Grid.Column="3" Text="Option" />
                <TextBlock Grid.Column="4" Text="% of cap" />
              </Grid>
              <ItemsControl Classes="table" ItemsSource="{Binding ContractYears}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContractYearRow">
                    <Grid ColumnDefinitions="100,140,140,140,*" Height="30">
                      <TextBlock Text="{Binding Season}" Classes="dim" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Salary}" Classes="num" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Guaranteed}" Classes="small" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Option}" Classes="warn small" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding ShareOfCap}" Classes="num small" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </TabItem>

        <TabItem Header="Career">
          <StackPanel Spacing="4" Margin="0,14,0,0">
            <TextBlock Text="No career history yet." Classes="faint small" IsVisible="{Binding !HasCareer}" />
            <StackPanel Spacing="4" IsVisible="{Binding HasCareer}">
              <ScrollViewer Classes="tablewrap">
                <StackPanel Spacing="4">
                  <Grid Classes="thead" ColumnDefinitions="72,*,Auto">
                    <TextBlock Text="Season" />
                    <TextBlock Grid.Column="1" Text="Team" MinWidth="{StaticResource TableNameMinWidth}" />
                    <ItemsControl Grid.Column="2" Classes="statheads" ItemsSource="{Binding CareerHeaders}" />
                  </Grid>
                  <ItemsControl Classes="table" ItemsSource="{Binding Career}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CareerRow">
                        <Grid ColumnDefinitions="72,*,Auto" Height="28">
                          <TextBlock Text="{Binding Season}" Classes="small" Classes.accent="{Binding IsCurrent}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Team}" Classes="dim small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                          <ItemsControl Grid.Column="2" Classes="statrow" ItemsSource="{Binding Cells}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Text="{Binding CareerTotalsLine}" Classes="dim small" Margin="10,6,0,0" />
            </StackPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
