<UserControl
  x:Class="BallGM.Client.Avalonia.Views.PlayerProfileView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  xmlns:views="clr-namespace:BallGM.Client.Avalonia.Views"
  x:DataType="vm:PlayerProfileViewModel">
  <UserControl.Resources>
    <!-- One titled panel of stat tiles, for the simulated and the stated season alike. -->
    <DataTemplate x:Key="StatGroupTemplate" x:DataType="vm:StatGroup">
      <Border Classes="panel" Margin="0,0,0,14">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Title}" Classes="section" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}" Classes="faint tiny" VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatCell">
                <Border Classes="stat" MinWidth="104" Padding="12,8" ToolTip.Tip="{Binding Definition}" AutomationProperties.Name="{Binding AccessibleName}">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                    <TextBlock Text="{Binding Value}" Classes="num statvalue" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Spacing="18">
      <Button Content="‹ Back to roster" Command="{Binding BackCommand}" HorizontalAlignment="Left" />

      <!-- Identity: portrait, name, rating, bio. -->
      <Border Classes="panel">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
          <Border Classes="face" Width="104" Height="104" CornerRadius="52">
            <Image Source="{Binding PortraitPath, Converter={x:Static conv:ImagePathConverter.Instance}}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="pill">
                <TextBlock Text="{Binding Position}" />
              </Border>
              <TextBlock Text="{Binding TeamLine}" Classes="eyebrow accent" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding FullName}" Classes="display" />
            <TextBlock Text="{Binding BioLine}" Classes="dim" />
            <Border Classes="pill bad" IsVisible="{Binding IsInjured}">
              <TextBlock Text="{Binding InjuryDescription}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="Overall" Classes="eyebrow" HorizontalAlignment="Center" />
            <Border Classes="ovr" Width="84" Height="56" CornerRadius="6" Background="{Binding Overall, Converter={x:Static conv:OverallTierConverter.Instance}}">
              <TextBlock Text="{Binding Overall}" FontSize="32" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Classes="profile">
        <TabItem Header="Overview">
          <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="18" Margin="0,14,0,0">
            <StackPanel Spacing="18">
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Text="Attributes" Classes="section" />
              <ItemsControl ItemsSource="{Binding Attributes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AttributeRow">
                    <Grid ColumnDefinitions="*,40" RowDefinitions="Auto,Auto" Margin="0,0,0,12" ToolTip.Tip="{Binding Meaning}">
                      <TextBlock Text="{Binding Name}" Classes="strong" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="num" HorizontalAlignment="Right" />
                      <ProgressBar
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Classes="attr"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Value}"
                        Foreground="{Binding Value, Converter={x:Static conv:OverallTierConverter.Instance}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Overall is the average of these five. Hover an attribute for what it covers." Classes="faint tiny" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="18">
          <StackPanel Spacing="8">
            <TextBlock Text="This season" Classes="section" />
            <TextBlock Text="No games played this season yet." Classes="faint small" IsVisible="{Binding !HasSeason}" />
            <ItemsControl ItemsSource="{Binding SeasonTiles}" IsVisible="{Binding HasSeason}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatTile">
                  <Border Classes="stat" MinWidth="88">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                      <TextBlock Text="{Binding Value}" Classes="value" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>


            </StackPanel>
          <!-- Full width: a game log carries the whole box-score line and needs the room. -->
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="Recent form" Classes="section" />
            <TextBlock Text="Form appears once this player has played in a simulated game." Classes="faint small" IsVisible="{Binding !HasRecentGames}" />
            <ScrollViewer Classes="tablewrap" IsVisible="{Binding HasRecentGames}">
              <StackPanel Spacing="4">
                  <Grid Classes="thead" ColumnDefinitions="64,*,96,Auto">
                    <TextBlock Text="Date" />
                    <TextBlock Grid.Column="1" Text="Opponent" MinWidth="{StaticResource TableNameMinWidth}" />
                    <TextBlock Grid.Column="2" Text="Result" />
                    <ItemsControl Grid.Column="3" Classes="statheads" ItemsSource="{Binding GameLogHeaders}" />
                  </Grid>
                  <ItemsControl Classes="table" ItemsSource="{Binding RecentGames}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentGameRow">
                        <Grid ColumnDefinitions="64,*,96,Auto" Height="30">
                          <TextBlock Text="{Binding Date}" Classes="dim small" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Opponent}" Classes="strong small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding Result}" Classes="num small" Classes.good="{Binding Won}" Classes.bad="{Binding !Won}" VerticalAlignment="Center" />
                          <ItemsControl Grid.Column="3" Classes="statrow" ItemsSource="{Binding Stats}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Stats">
          <StackPanel Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="This season, simulated" Classes="section" />
            <TextBlock Text="No games played this season yet. Start or advance the season on the Calendar." Classes="faint small" IsVisible="{Binding !HasSimulatedStats}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" Margin="0,0,0,6" IsVisible="{Binding HasSimulatedStats}">
              <views:BasisToggle DataContext="{Binding Basis}" />
              <TextBlock Text="{Binding SimulatedSample}" Classes="faint small" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SimulatedGroups}" ItemTemplate="{StaticResource StatGroupTemplate}" />
            <TextBlock Text="{Binding StatedSeasonTitle}" Classes="eyebrow" IsVisible="{Binding HasStatedStats}" Margin="0,10,0,0" />
            <ItemsControl ItemsSource="{Binding StatedGroups}" ItemTemplate="{StaticResource StatGroupTemplate}" />
            <TextBlock Text="Hover any stat for its definition. Simulated rate stats use the player's share of team minutes, the standard box-score estimate." Classes="faint tiny" TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Contract">
          <StackPanel Spacing="16" Margin="0,14,0,0">
            <TextBlock Text="{Binding ContractSummary}" Classes="h3" />
            <ItemsControl ItemsSource="{Binding ContractTiles}" IsVisible="{Binding HasContractDetail}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatTile">
                  <Border Classes="stat accent">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                      <TextBlock Text="{Binding Value}" Classes="value" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="panel" IsVisible="{Binding HasContractDetail}">
              <StackPanel Spacing="8">
                <TextBlock Text="Salary scale" Classes="section" />
                <Panel Width="360" Height="10" HorizontalAlignment="Left">
                  <Border Width="360" Height="10" CornerRadius="5" Background="{StaticResource Bg3Brush}" />
                  <Border Width="{Binding SalaryScaleFill}" Height="10" CornerRadius="5" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                </Panel>
                <TextBlock Text="{Binding SalaryScaleLine}" Classes="dim small" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="4" IsVisible="{Binding HasContractDetail}">
              <Grid Classes="thead" ColumnDefinitions="100,140,140,140,*">
                <TextBlock Text="Season" />
                <TextBlock Grid.Column="1" Text="Salary" />
                <TextBlock Grid.Column="2" Text="Guaranteed" />
                <TextBlock Grid.Column="3" Text="Option" />
                <TextBlock Grid.Column="4" Text="% of cap" />
              </Grid>
              <ItemsControl Classes="table" ItemsSource="{Binding ContractYears}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContractYearRow">
                    <Grid ColumnDefinitions="100,140,140,140,*" Height="30">
                      <TextBlock Text="{Binding Season}" Classes="dim" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Salary}" Classes="num" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Guaranteed}" Classes="small" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Option}" Classes="warn small" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding ShareOfCap}" Classes="num small" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </TabItem>

        <TabItem Header="Career">
          <StackPanel Spacing="4" Margin="0,14,0,0">
            <TextBlock Text="No career history yet." Classes="faint small" IsVisible="{Binding !HasCareer}" />
            <StackPanel Spacing="4" IsVisible="{Binding HasCareer}">
              <ScrollViewer Classes="tablewrap">
                <StackPanel Spacing="4">
                  <Grid Classes="thead" ColumnDefinitions="72,*,Auto">
                    <TextBlock Text="Season" />
                    <TextBlock Grid.Column="1" Text="Team" MinWidth="{StaticResource TableNameMinWidth}" />
                    <ItemsControl Grid.Column="2" Classes="statheads" ItemsSource="{Binding CareerHeaders}" />
                  </Grid>
                  <ItemsControl Classes="table" ItemsSource="{Binding Career}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CareerRow">
                        <Grid ColumnDefinitions="72,*,Auto" Height="28">
                          <TextBlock Text="{Binding Season}" Classes="small" Classes.accent="{Binding IsCurrent}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Team}" Classes="dim small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                          <ItemsControl Grid.Column="2" Classes="statrow" ItemsSource="{Binding Cells}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Text="{Binding CareerTotalsLine}" Classes="dim small" Margin="10,6,0,0" />
            </StackPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
