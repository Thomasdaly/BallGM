<UserControl
  x:Class="BallGM.Client.Avalonia.Views.PlayerProfileView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  xmlns:views="clr-namespace:BallGM.Client.Avalonia.Views"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls"
  x:DataType="vm:PlayerProfileViewModel">
  <!-- S10 Player profile, template T3: hero band in the player's team colours, tab strip, panels. -->
  <UserControl.Resources>
    <DataTemplate x:Key="GroupTile" x:DataType="vm:AttributeGroupDisplay">
      <ctl:Tile Margin="{StaticResource GapBottom16}">
        <ctl:AttributeGroup Title="{Binding Title}" Average="{Binding Average}">
          <ItemsControl ItemsSource="{Binding Attributes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AttributeCell">
                <ctl:AttributeBar Label="{Binding Name}" Value="{Binding Value}" ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding AccessibleName}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ctl:AttributeGroup>
      </ctl:Tile>
    </DataTemplate>
    <DataTemplate x:Key="StatGroupTile" x:DataType="vm:StatGroup">
      <ctl:Tile Title="{Binding Title}" Margin="{StaticResource GapBottom16}">
        <StackPanel Spacing="{StaticResource Space8}">
          <TextBlock Text="{Binding Subtitle}" Classes="caption wrap" />
          <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="{StaticResource Space16}" LineSpacing="{StaticResource Space12}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatCell">
                <StackPanel MinWidth="88" ToolTip.Tip="{Binding Definition}" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Text="{Binding Value}" Classes="stat-m" />
                  <TextBlock Text="{Binding Label, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="label-caps" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ctl:Tile>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{StaticResource Space16}">

      <!-- Hero: the player's team colour as a solid field (text on it uses OnPrimaryRaw), fading out to the
           right; the headshot stands on the band and overlaps its bottom edge. -->
      <Panel>
        <ctl:CutCornerBorder Background="{StaticResource CanvasBrush}" ClipContent="True" Height="296">
          <Grid ColumnDefinitions="3*,2*">
            <Border Background="{DynamicResource TeamPrimaryRawBrush}" />
            <Border Grid.Column="1" Background="{DynamicResource TeamGradientBrush}" />
            <ctl:TeamLogo Grid.Column="1" TeamId="{Binding TeamId}" TeamName="{Binding TeamLine}" Size="256" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource PadH24}" IsHitTestVisible="False" />
            <StackPanel Spacing="{StaticResource Space8}" VerticalAlignment="Center" Margin="307,0,16,0">
              <TextBlock Text="{Binding HeroLine}" Classes="caps large trim on-primary" ToolTip.Tip="{Binding HeroLine}" />
              <TextBlock Text="{Binding FullName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="hero small wrap on-primary" MaxLines="2" ToolTip.Tip="{Binding FullName}" />
              <ItemsControl ItemsSource="{Binding StatusChips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="{StaticResource Space8}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ctl:StatusItem">
                    <ctl:StatusChip Text="{Binding Text}" Kind="{Binding Kind}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ContractSummary}" Classes="body-strong trim on-primary" />
              <TextBlock Text="{Binding HeroSubLine}" Classes="body trim on-primary" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" Margin="{StaticResource GapTop8}" IsVisible="{Binding IsOwnPlayer}">
                <Button Classes="primary" Content="OFFER EXTENSION" Command="{Binding ExtendCommand}" IsVisible="{Binding CanExtend}" />
                <Button Classes="secondary" Content="Shop in trades" Command="{Binding TradeCommand}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space16}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource PadH24}">
              <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Pad12}" VerticalAlignment="Center" IsVisible="{Binding SeasonRating, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="{StaticResource Space4}">
                  <TextBlock Text="SEASON RATING" Classes="label-caps" HorizontalAlignment="Center" />
                  <views:RatingPill DataContext="{Binding SeasonRating}" HorizontalAlignment="Center" />
                  <ctl:FormSparkline Values="{Binding RatingTrend}" Width="128" IsVisible="{Binding HasRatingTrend}" ToolTip.Tip="{Binding RatingTrendText, StringFormat='Last games, oldest first: {0}'}" AutomationProperties.Name="{Binding RatingTrendText, StringFormat='Match ratings, last games oldest first: {0}'}" />
                </StackPanel>
              </Border>
              <ctl:RatingBadge Value="{Binding Overall}" Size="ExtraLarge" Caption="OVR" VerticalAlignment="Center" />
              <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Pad12}" VerticalAlignment="Center" DataContext="{Binding Sheet}" ToolTip.Tip="Potential is kept hidden; the scouts rate it in stars.">
                <StackPanel Spacing="{StaticResource Space4}">
                  <TextBlock Text="{Binding PotentialStars}" Classes="h3" HorizontalAlignment="Center" AutomationProperties.Name="{Binding PotentialStarsName}" />
                  <TextBlock Text="POT" Classes="label-caps" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ctl:CutCornerBorder>
        <ctl:PlayerHeadshot PlayerId="{Binding PlayerId}" PlayerName="{Binding FullName}" Size="Hero" Width="267" Height="320" IsInjured="{Binding IsInjured}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,-24" />
      </Panel>

      <ctl:SkewTabStrip ItemsSource="{Binding Tabs}" SelectedIndex="{Binding TabIndex}" Margin="307,0,0,0" />

      <!-- Overview: scouting report, top attribute groups, last games. -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource Space16}" IsVisible="{Binding IsOverviewTab}">
        <StackPanel Spacing="{StaticResource Space16}" DataContext="{Binding Sheet}">
          <ctl:Tile Title="Scouting report">
            <StackPanel Spacing="{StaticResource Space12}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space16}" RowSpacing="{StaticResource Space8}">
                <TextBlock Text="CURRENT" Classes="label-caps" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentStars}" Classes="body-strong" AutomationProperties.Name="{Binding CurrentStarsName}" ToolTip.Tip="{Binding CurrentStarsName}" />
                <TextBlock Grid.Row="1" Text="POTENTIAL" Classes="label-caps" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PotentialStars}" Classes="body-strong" AutomationProperties.Name="{Binding PotentialStarsName}" ToolTip.Tip="{Binding PotentialStarsName}" />
                <TextBlock Grid.Row="2" Text="PERSONALITY" Classes="label-caps" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Personality}" Classes="body-strong" />
              </Grid>
              <TextBlock Text="{Binding Body}" Classes="body secondary wrap" IsVisible="{Binding HasBody}" />
              <TextBlock Text="POSITIONS" Classes="label-caps" />
              <ItemsControl ItemsSource="{Binding Positions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PositionChip">
                    <Border Classes="familiarity" Classes.natural="{Binding IsNatural}" Classes.accomplished="{Binding IsAccomplished}" Classes.competent="{Binding IsCompetent}" Margin="0,0,4,0" Padding="{StaticResource Pad4}" CornerRadius="{StaticResource RadiusChip}" ToolTip.Tip="{Binding AccessibleName}" AutomationProperties.Name="{Binding AccessibleName}">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Position}" Classes="body-strong" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Familiarity, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="label-caps trim" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="TRAITS" Classes="label-caps" IsVisible="{Binding HasTraits}" />
              <ItemsControl ItemsSource="{Binding Traits}" IsVisible="{Binding HasTraits}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="{StaticResource Space8}" LineSpacing="{StaticResource Space8}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <ctl:StatusChip Text="{Binding}" Kind="Accent" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ctl:Tile>
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding OverviewGroups}" ItemTemplate="{StaticResource GroupTile}" />
        <StackPanel Grid.Column="2" Spacing="{StaticResource Space16}">
          <ctl:Tile Title="Last 10 games">
            <StackPanel Spacing="{StaticResource Space12}">
              <TextBlock Text="Form appears once this player has played in a simulated game." Classes="body secondary wrap" IsVisible="{Binding !HasRecentGames}" />
              <TextBlock Text="MATCH RATING" Classes="label-caps" IsVisible="{Binding HasRatingTrend}" />
              <ctl:FormSparkline Values="{Binding RatingTrend}" Height="40" HorizontalAlignment="Stretch" IsVisible="{Binding HasRatingTrend}" />
              <ctl:WinLossStrip Results="{Binding FormResults}" IsVisible="{Binding HasRecentGames}" />
            </StackPanel>
          </ctl:Tile>
          <ctl:Tile Title="This season">
            <Panel>
              <TextBlock Text="No games played this season yet." Classes="body secondary" IsVisible="{Binding !HasSeason}" />
              <ItemsControl ItemsSource="{Binding SeasonTiles}" IsVisible="{Binding HasSeason}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="{StaticResource Space24}" LineSpacing="{StaticResource Space12}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatTile">
                    <ctl:StatTile Value="{Binding Value}" Label="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ctl:Tile>
        </StackPanel>
      </Grid>

      <!-- Ratings: every attribute group. -->
      <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTile}" IsVisible="{Binding IsRatingsTab}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" ColumnSpacing="{StaticResource Space16}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Stats: the simulated season (basis), against the league, shooting by zone, the stated season. -->
      <StackPanel Spacing="{StaticResource Space16}" IsVisible="{Binding IsStatsTab}">
        <ctl:EmptyState IconKey="Icon.Leaders" Headline="No games this season" Message="Stats fill in after this player's first simulated game. Advance the season with Continue." IsVisible="{Binding !HasSimulatedStats}" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space16}" IsVisible="{Binding HasSimulatedStats}">
          <ctl:SegmentedControl ItemsSource="{Binding BasisOptions}" SelectedIndex="{Binding BasisIndex}" AutomationProperties.Name="Stat basis" />
          <TextBlock Text="{Binding SimulatedSample}" Classes="caption" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding SimulatedGroups}" ItemTemplate="{StaticResource StatGroupTile}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space16}" IsVisible="{Binding HasSimulatedStats}">
          <ctl:Tile Title="Against the league">
            <StackPanel Spacing="{StaticResource Space8}">
              <TextBlock Text="Percentile among qualified players this regular season, per game. Higher is better on every row." Classes="caption wrap" />
              <TextBlock Text="{Binding NotRankedNote}" Classes="body secondary wrap" IsVisible="{Binding !HasPercentiles}" />
              <ItemsControl ItemsSource="{Binding Percentiles}" IsVisible="{Binding HasPercentiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PercentileRow">
                    <Grid ColumnDefinitions="64,*,56" ColumnSpacing="{StaticResource Space8}" Height="28" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding AccessibleName}">
                      <TextBlock Text="{Binding Stat}" Classes="body-strong" VerticalAlignment="Center" />
                      <ctl:RatingTrack Grid.Column="1" Value="{Binding Percentile}" Height="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="table" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ctl:Tile>
          <ctl:Tile Grid.Column="1" Title="Shooting by zone" IsVisible="{Binding HasShotChart}">
            <StackPanel Spacing="{StaticResource Space12}">
              <TextBlock Text="Field-goal percentage by zone, against the league from the same spot." Classes="caption wrap" />
              <ctl:ShotChart Zones="{Binding ShotChart.Zones}" MaxWidth="520" HorizontalAlignment="Left" AutomationProperties.Name="Shot chart: field-goal percentage by zone against the league. The same figures are in the list below it." />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                  <Border Width="12" Height="12" CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource ChartCold2Brush}" />
                  <TextBlock Text="Colder than league" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                  <Border Width="12" Height="12" CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource ChartNeutralBrush}" />
                  <TextBlock Text="{x:Static vm:ShotChartView.LevelLegend}" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                  <Border Width="12" Height="12" CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource ChartHot2Brush}" />
                  <TextBlock Text="Hotter than league" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ShotChart.Zones}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShotZoneCell">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space16}" Height="28" AutomationProperties.Name="{Binding AccessibleName}">
                      <TextBlock Text="{Binding Name}" Classes="body" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Shooting}" Classes="table" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Difference}" Classes="caption num" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="120" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ctl:Tile>
        </Grid>
        <TextBlock Text="{Binding StatedSeasonTitle}" Classes="label-caps" IsVisible="{Binding HasStatedStats}" />
        <ItemsControl ItemsSource="{Binding StatedGroups}" ItemTemplate="{StaticResource StatGroupTile}" />
        <TextBlock Text="Hover any stat for its definition. Simulated rate stats use the player's share of team minutes, the standard box-score estimate." Classes="caption wrap" />
      </StackPanel>

      <!-- Game log. -->
      <Panel IsVisible="{Binding IsGameLogTab}">
        <ctl:DataTable Height="520" Columns="{Binding GameLogColumns}" Rows="{Binding GameLogRows}" EmptyHeadline="No games yet" EmptyMessage="The log fills in after this player's first simulated game this season." />
      </Panel>

      <!-- Contract. -->
      <StackPanel Spacing="{StaticResource Space16}" IsVisible="{Binding IsContractTab}">
        <TextBlock Text="{Binding ContractSummary}" Classes="h3" />
        <ctl:EmptyState IconKey="Icon.Contracts" Headline="No contract" Message="Free agents appear in Free agency, where an offer starts one." IsVisible="{Binding !HasContractDetail}" />
        <ItemsControl ItemsSource="{Binding ContractTiles}" IsVisible="{Binding HasContractDetail}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" ColumnSpacing="{StaticResource Space16}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StatTile">
              <ctl:Tile Classes="compact">
                <ctl:StatTile Value="{Binding Value}" Label="{Binding Label}" />
              </ctl:Tile>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ctl:Tile Title="Salary scale" IsVisible="{Binding HasContractDetail}">
          <StackPanel Spacing="{StaticResource Space8}">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding SalaryScalePosition}" Height="8" MaxWidth="480" HorizontalAlignment="Left" AutomationProperties.Name="{Binding SalaryScaleLine}" />
            <TextBlock Text="{Binding SalaryScaleLine}" Classes="body secondary wrap" />
          </StackPanel>
        </ctl:Tile>
        <ctl:DataTable Height="260" Columns="{Binding ContractColumns}" Rows="{Binding ContractRows}" IsVisible="{Binding HasContractDetail}" EmptyHeadline="No contract years" />
      </StackPanel>

      <!-- Career. -->
      <StackPanel Spacing="{StaticResource Space12}" IsVisible="{Binding IsCareerTab}">
        <ctl:DataTable Height="440" Columns="{Binding CareerColumns}" Rows="{Binding CareerRows}" EmptyHeadline="No career history yet" EmptyMessage="Seasons appear here as this player plays them, or as a data pack states them." />
        <TextBlock Text="{Binding CareerTotalsLine}" Classes="body secondary" IsVisible="{Binding HasCareer}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
