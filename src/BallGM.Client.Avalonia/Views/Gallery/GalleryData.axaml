<UserControl
  x:Class="BallGM.Client.Avalonia.Views.Gallery.GalleryData"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  x:DataType="vm:ComponentGalleryViewModel">
  <StackPanel Spacing="{StaticResource Space24}">
    <ctl:HeroBand>
      <StackPanel Spacing="{StaticResource Space12}">
        <TextBlock Text="ON THE TEAM HERO" Classes="caps" />
        <WrapPanel ItemSpacing="{StaticResource Space24}" LineSpacing="{StaticResource Space12}">
          <ctl:RatingBadge Value="93" Size="ExtraLarge" Caption="OVR" />
          <ctl:RatingBadge Value="84" Size="Large" VerticalAlignment="Center" />
          <ctl:Tile Title="Cap space" Classes="compact" Width="240">
            <ctl:StatTile Value="$3.1M" Label="Under the tax" />
          </ctl:Tile>
          <Border Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Pad12}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
              <ctl:PositionChip Text="SF/PF" />
              <ctl:StatusChip Text="Healthy" Kind="Positive" />
              <ctl:StatusChip Text="Day to day" Kind="Warning" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>
    </ctl:HeroBand>
    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="{StaticResource Space24}">
      <ctl:Tile Title="Next game" ActionText="Preview" ActionCommand="{Binding NoOpCommand}" IsFeatured="True">
        <StackPanel Spacing="{StaticResource Space8}">
          <TextBlock Text="TUE 14 JAN · 7:30 PM · HOME" Classes="label-caps" Foreground="{DynamicResource OnPrimaryRawBrush}" />
          <TextBlock Text="MARINERS vs FORGE" Classes="hero small" Foreground="{DynamicResource OnPrimaryRawBrush}" />
        </StackPanel>
      </ctl:Tile>
      <ctl:Tile Grid.Column="1" Title="Cap space" ActionText="Finances" ActionCommand="{Binding NoOpCommand}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space24}">
          <ctl:StatTile Value="$3.1M" Label="Under the tax" Delta="$1.2M vs last week" Direction="Up" />
          <ctl:StatTile Value="2" Label="Spots open" />
        </StackPanel>
      </ctl:Tile>
      <ctl:Tile Grid.Column="2" Title="Team leaders" Classes="clickable" ctl:ForceState.PseudoClasses="pointerover">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space24}">
          <ctl:StatTile Value="24.1" Label="PTS" Delta="4th in league" />
          <ctl:StatTile Value="-1.8" Label="Net rating" Delta="2.1 vs average" Direction="Down" />
        </StackPanel>
      </ctl:Tile>
    </Grid>
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource Space24}">
      <ctl:Tile Title="Compact card" Classes="compact">
        <TextBlock Text="12px padding for dense dashboards." Classes="body secondary wrap" />
      </ctl:Tile>
      <ctl:Tile Grid.Column="1" Title="Clickable card" Classes="clickable">
        <TextBlock Text="Steps up a surface on hover." Classes="body secondary wrap" />
      </ctl:Tile>
      <ctl:Tile Grid.Column="2" Title="Pressed" Classes="clickable" ctl:ForceState.PseudoClasses="pressed">
        <TextBlock Text="Pressed state." Classes="body secondary wrap" />
      </ctl:Tile>
      <ctl:Tile Grid.Column="3" Title="Focused" Classes="clickable" ctl:ForceState.PseudoClasses="focus-visible">
        <TextBlock Text="Keyboard focus ring outside." Classes="body secondary wrap" />
      </ctl:Tile>
    </Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space24}">
      <Border Background="{StaticResource Surface1Brush}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}">
        <StackPanel Spacing="{StaticResource Space12}">
          <TextBlock Text="RATING BADGE · S / M / L / XL · EVERY TIER" Classes="label-caps" />
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <ctl:RatingBadge Value="94" Size="Small" />
            <ctl:RatingBadge Value="84" Size="Small" />
            <ctl:RatingBadge Value="74" Size="Small" />
            <ctl:RatingBadge Value="64" Size="Small" />
            <ctl:RatingBadge Value="54" Size="Small" />
            <ctl:RatingBadge Value="44" Size="Small" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <ctl:RatingBadge Value="94" />
            <ctl:RatingBadge Value="84" />
            <ctl:RatingBadge Value="74" />
            <ctl:RatingBadge Value="64" />
            <ctl:RatingBadge Value="54" />
            <ctl:RatingBadge Value="44" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <ctl:RatingBadge Value="94" Size="Large" />
            <ctl:RatingBadge Value="84" Size="Large" />
            <ctl:RatingBadge Value="74" Size="Large" />
            <ctl:RatingBadge Value="93" Size="ExtraLarge" Caption="OVR" />
            <ctl:RatingBadge Value="95" Size="ExtraLarge" Caption="POT" />
          </StackPanel>
          <TextBlock Text="POSITION CHIP · STATUS CHIP" Classes="label-caps" Margin="{StaticResource GapTop8}" />
          <WrapPanel ItemSpacing="{StaticResource Space8}" LineSpacing="{StaticResource Space8}">
            <ctl:PositionChip Text="PG" />
            <ctl:PositionChip Text="SF/PF" />
            <ctl:StatusChip Text="Out · 2-3 weeks" Kind="Negative" />
            <ctl:StatusChip Text="Day to day" Kind="Warning" />
            <ctl:StatusChip Text="Healthy" Kind="Positive" />
            <ctl:StatusChip Text="Expiring" Kind="Warning" />
            <ctl:StatusChip Text="Player option" Kind="Info" />
            <ctl:StatusChip Text="Team option" Kind="Info" />
            <ctl:StatusChip Text="Rookie scale" Kind="Neutral" />
            <ctl:StatusChip Text="Starter" Kind="Accent" />
            <ctl:StatusChip Text="Traded" Kind="Neutral" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Surface1Brush}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}">
        <StackPanel Spacing="{StaticResource Space8}">
          <TextBlock Text="ATTRIBUTE GROUP · BAR · SINGLE / COMPARE / DELTA" Classes="label-caps" />
          <ctl:AttributeGroup Title="Outside scoring" Average="76">
            <StackPanel Spacing="{StaticResource Space4}">
              <ctl:AttributeBar Label="Three-point" Value="85" Delta="2" />
              <ctl:AttributeBar Label="Mid-range" Value="74" Delta="-1" />
            </StackPanel>
          </ctl:AttributeGroup>
          <ctl:AttributeGroup Title="Defence (compare: tick is the other player)" Average="53">
            <StackPanel Spacing="{StaticResource Space4}">
              <ctl:AttributeBar Label="Perimeter defence" Value="66" CompareValue="81" />
              <ctl:AttributeBar Label="Block" Value="52" CompareValue="38" />
              <ctl:AttributeBar Label="Post control" Value="41" />
            </StackPanel>
          </ctl:AttributeGroup>
          <TextBlock Text="KEY VALUE LIST" Classes="label-caps" Margin="{StaticResource GapTop8}" />
          <ctl:KeyValueList Items="{Binding BioFacts}" Columns="3" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
