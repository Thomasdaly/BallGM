<UserControl
  x:Class="BallGM.Client.Avalonia.Views.Gallery.ComponentGalleryView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  xmlns:gallery="clr-namespace:BallGM.Client.Avalonia.Views.Gallery"
  x:DataType="vm:ComponentGalleryViewModel"
  Background="{StaticResource CanvasBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource TeamGradientBrush}" Padding="{StaticResource Pad24x16}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space12}">
        <StackPanel>
          <TextBlock Text="COMPONENT GALLERY" Classes="h1" Foreground="{DynamicResource OnPrimaryRawBrush}" />
          <TextBlock Text="Developer reference: every component, variant and state. Not part of the game's navigation." Classes="body" Foreground="{DynamicResource OnPrimaryRawBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
          <TextBlock Text="TEAM" Classes="caps" Foreground="{DynamicResource OnPrimaryRawBrush}" VerticalAlignment="Center" />
          <ctl:SegmentedControl ItemsSource="{Binding Teams}" SelectedItem="{Binding Team}" AutomationProperties.Name="Gallery team">
            <ctl:SegmentedControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryTeam">
                <TextBlock Text="{Binding Abbreviation}" ToolTip.Tip="{Binding Name}" />
              </DataTemplate>
            </ctl:SegmentedControl.ItemTemplate>
          </ctl:SegmentedControl>
        </StackPanel>
        <ctl:SkewTabStrip Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionIndex}" />
      </Grid>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="{StaticResource Pad24}">
        <gallery:GalleryFoundations IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Foundations}" />
        <gallery:GalleryActions IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Actions}" />
        <gallery:GalleryNavigation IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Navigation}" />
        <gallery:GalleryInputs IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Inputs}" />
        <gallery:GalleryData IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Data}" />
        <gallery:GalleryTables IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Tables}" />
        <gallery:GalleryMedia IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Media}" />
        <gallery:GallerySports IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Sports}" />
        <gallery:GalleryFeedback IsVisible="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Feedback}" />
      </Panel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
