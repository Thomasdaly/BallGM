<UserControl
  x:Class="BallGM.Client.Avalonia.Views.CapSheetView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  x:DataType="vm:CapSheetViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16">
      <StackPanel Spacing="2">
                <TextBlock Text="{Binding SeasonLine}" Opacity="0.7" />
      </StackPanel>

      <Border Classes="callout">
        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" />
      </Border>

      <!-- Where the payroll sits along the lines, floor to second apron. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasThresholds}">
        <TextBlock Classes="section" Text="Cap position" />
        <Canvas Width="820" Height="80" HorizontalAlignment="Left">
          <Border Canvas.Top="30" Width="820" Height="12" CornerRadius="6" Background="{StaticResource Bg3Brush}" />
          <Border Canvas.Top="30" Width="{Binding GaugeFill}" Height="12" CornerRadius="6" Background="{StaticResource AccentBrush}" />
          <ItemsControl ItemsSource="{Binding GaugeMarkers}" Width="820" Height="80">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter" x:DataType="vm:GaugeMarker">
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GaugeMarker">
                <Canvas>
                  <Border Canvas.Top="24" Width="2" Height="24" Background="{StaticResource TextBrush}" />
                  <StackPanel Canvas.Top="{Binding LabelTop}" Canvas.Left="-30" Width="120" Spacing="0">
                    <TextBlock Text="{Binding Name}" Classes="tiny strong" />
                    <TextBlock Text="{Binding Amount}" Classes="tiny dim" />
                  </StackPanel>
                </Canvas>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Canvas>
      </StackPanel>

      <!-- What this payroll costs the team in freedom. -->
      <StackPanel Spacing="8" IsVisible="{Binding HasRestrictions}">
        <TextBlock Classes="section" Text="What this payroll restricts" />
        <ItemsControl ItemsSource="{Binding Restrictions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RestrictionRow">
              <Border Classes="callout warn" Margin="0,0,0,6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RuleCode}" Classes="code" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The luxury-tax bill, bracket by bracket. -->
      <Border Classes="panel" IsVisible="{Binding HasTaxBill}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="section" Text="Luxury tax" />
              <TextBlock Text="{Binding TaxBillLine}" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
              <TextBlock Text="Projected bill" Classes="eyebrow" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding TaxOwed}" Classes="display" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <ItemsControl Classes="table" ItemsSource="{Binding TaxBrackets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TaxBracketRow">
                <Grid ColumnDefinitions="120,140,160,*" Height="28">
                  <TextBlock Text="{Binding Bracket}" Classes="dim small" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Salary}" Classes="num" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Rate}" Classes="small" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Tax}" Classes="num warn" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="Payroll" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12">
          <Border Classes="stat accent">
            <StackPanel Spacing="2">
              <TextBlock Text="Total payroll" Classes="eyebrow" />
              <TextBlock Text="{Binding TotalPayroll}" Classes="value" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel Spacing="2">
              <TextBlock Text="Committed salary" Classes="eyebrow" />
              <TextBlock Text="{Binding CommittedSalary}" Classes="value" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel Spacing="2">
              <TextBlock Text="Dead money" Classes="eyebrow" />
              <TextBlock Text="{Binding DeadMoney}" Classes="value" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="Thresholds" />

        <Border Classes="callout" IsVisible="{Binding !HasThresholds}">
          <TextBlock Text="{Binding NoThresholdsExplanation}" TextWrapping="Wrap" />
        </Border>

        <Grid Classes="thead" ColumnDefinitions="140,110,140" IsVisible="{Binding HasThresholds}">
          <TextBlock Classes="eyebrow" Text="Line" />
          <TextBlock Classes="eyebrow" Grid.Column="1" Text="Amount" />
          <TextBlock Classes="eyebrow" Grid.Column="2" Text="Distance" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Thresholds}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThresholdRow">
              <StackPanel Spacing="1" Margin="0,0,0,8">
                <Grid ColumnDefinitions="140,110,140">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Amount}" />
                  <TextBlock Grid.Column="2" Text="{Binding Distance}" FontWeight="SemiBold" />
                </Grid>
                <TextBlock Text="{Binding Explanation}" Opacity="0.65" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="What the payroll is made of" />
        <ItemsControl Classes="table" ItemsSource="{Binding Charges}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChargeRow">
              <Grid ColumnDefinitions="240,140,*" Height="24">
                <TextBlock Text="{Binding PlayerName}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Amount}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="Recent transactions" />
        <ItemsControl Classes="table" ItemsSource="{Binding Transactions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LedgerRow">
              <Grid ColumnDefinitions="130,140,90,*" Height="24">
                <TextBlock Text="{Binding RecordedAt}" VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Amount}" VerticalAlignment="Center" />
                <TextBlock
                  Grid.Column="3"
                  Text="{Binding Reason}"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
