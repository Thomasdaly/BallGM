<UserControl
  x:Class="BallGM.Client.Avalonia.Views.PickBoardView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  x:DataType="vm:PickBoardViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <StackPanel Spacing="2">
      <TextBlock Text="Pick ownership" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SeasonLine}" Opacity="0.7" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" MaxHeight="300">
      <StackPanel Spacing="4">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PickBoardRow">
              <Grid ColumnDefinitions="220,*" Margin="0,0,0,4">
                <TextBlock
                  Text="{Binding FranchiseName}"
                  VerticalAlignment="Top"
                  Margin="0,4,8,0"
                  TextTrimming="CharacterEllipsis" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PickCellRow">
                      <Border Width="152" Padding="6" CornerRadius="3" Background="#18808080">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding DraftSeason}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                          <ItemsControl ItemsSource="{Binding Assets}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PickChip">
                                <StackPanel Spacing="0" Margin="0,0,0,3">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding State}" FontSize="12" Opacity="0.8" />
                                  </StackPanel>
                                  <TextBlock
                                    Text="{Binding Protection}"
                                    IsVisible="{Binding IsConditional}"
                                    FontSize="10"
                                    Opacity="0.65"
                                    TextWrapping="Wrap" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock Text="{Binding SelectedFranchiseName}" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}" Opacity="0.75" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="16">
      <ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PickAssetRow">
            <StackPanel Spacing="1" Margin="0,2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding State}" Opacity="0.7" />
              </StackPanel>
              <TextBlock Text="{Binding Protection}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelectedAsset}">
        <StackPanel Spacing="10" DataContext="{Binding SelectedAsset}">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding OwnerLine}" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>

          <Border Padding="10" CornerRadius="3" Background="#20808080" IsVisible="{Binding HasProtection}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Protection}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding OutcomeIfProtectionHolds}" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="6" IsVisible="{Binding HasHistory}">
            <TextBlock Text="ASSET HISTORY" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LedgerRow">
                  <StackPanel Spacing="1" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding RecordedAt}" FontSize="11" Opacity="0.6" />
                      <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
