<UserControl
  x:Class="BallGM.Client.Avalonia.Views.SeasonView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  xmlns:app="clr-namespace:BallGM.Application.Seasons;assembly=BallGM.Application"
  xmlns:theming="clr-namespace:BallGM.Client.Avalonia.Theming"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  x:DataType="vm:SeasonViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseGameCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Resources>
    <!-- One player in a game sheet's line-up; the column meanings switch between preview and final. -->
    <DataTemplate x:Key="LineupRowTemplate" x:DataType="vm:LineupRow">
      <Grid ColumnDefinitions="34,*,42,38,40,40,40,44" Height="30" ToolTip.Tip="{Binding Tip}">
        <TextBlock Text="{Binding Position}" Classes="faint small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="small" Classes.strong="{Binding IsStarter}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
        <Border Grid.Column="2" Classes="ovr small" Background="{Binding Overall, Converter={x:Static conv:OverallTierConverter.Instance}}" IsVisible="{Binding HasOverall}">
          <TextBlock Text="{Binding Overall}" />
        </Border>
        <TextBlock Grid.Column="2" Text="—" Classes="faint small" VerticalAlignment="Center" IsVisible="{Binding !HasOverall}" />
        <TextBlock Grid.Column="3" Text="{Binding Minutes}" Classes="dim small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding Points}" Classes="num small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="{Binding Rebounds}" Classes="dim small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="6" Text="{Binding Assists}" Classes="dim small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="7" Text="{Binding Extra}" Classes="num small" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Panel>
  <ScrollViewer>
    <StackPanel Spacing="18">

      <!-- Where the league is, and the controls that move it. -->
      <Border Classes="panel">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Classes="h2" Text="{Binding Headline}" />
            <TextBlock Text="{Binding PhaseLine}" Classes="dim" />
            <TextBlock Text="{Binding AdvancePreview}" Classes="faint small" TextWrapping="Wrap" IsVisible="{Binding HasSeason}" />
          </StackPanel>

          <Button Grid.Column="1" Classes="primary" Content="Start season" Command="{Binding StartSeasonCommand}" VerticalAlignment="Center" IsVisible="{Binding HasNoSeason}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasSeason}">
            <TextBlock Text="Days" Classes="eyebrow" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding AdvanceOptions}" SelectedItem="{Binding AdvanceDays}" MinWidth="80" />
            <Button Classes="primary" Content="Advance" Command="{Binding AdvanceCommand}" />
            <Button Content="To end of season" Command="{Binding AdvanceToEndCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="callout" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>

      <!-- The season from the viewed team's chair: its record and form over a ribbon of every day
           of the season, wins rising above the line and losses falling below it, by margin. -->
      <Border Classes="panel" IsVisible="{Binding HasViewedTeam}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="{Binding TeamSeasonHeadline}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28">
              <Border Classes="stat">
                <StackPanel>
                  <TextBlock Classes="eyebrow" Text="Record" />
                  <TextBlock Classes="value" Text="{Binding TeamRecord}" />
                </StackPanel>
              </Border>
              <Border Classes="stat">
                <StackPanel>
                  <TextBlock Classes="eyebrow" Text="Streak" />
                  <TextBlock Classes="value" Text="{Binding TeamStreak}" />
                </StackPanel>
              </Border>
              <Border Classes="stat">
                <StackPanel>
                  <TextBlock Classes="eyebrow" Text="Games left" />
                  <TextBlock Classes="value" Text="{Binding TeamGamesRemaining}" />
                </StackPanel>
              </Border>
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="eyebrow" Text="Last five" />
                <ItemsControl ItemsSource="{Binding Form}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FormChip">
                      <Border Classes="form" Classes.win="{Binding IsWin}" ToolTip.Tip="{Binding Tip}">
                        <TextBlock Text="{Binding Letter}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="faint tiny" Text="No games yet" IsVisible="{Binding !HasForm}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel>
            <Panel Height="52">
              <ItemsControl ItemsSource="{Binding RibbonPhases}">
                <ItemsControl.Styles>
                  <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:RibbonPhase">
                    <Setter Property="theming:SpanPanel.Span" Value="{Binding Span}" />
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <theming:SpanPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RibbonPhase">
                    <Border Classes="ribbon-phase" Classes.alt="{Binding IsAlternate}" Classes.current="{Binding IsCurrent}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Height="1" Background="{StaticResource LineBrush}" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding RibbonDays}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <theming:SpanPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RibbonDay">
                    <Grid RowDefinitions="*,*" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                      <Border Grid.RowSpan="2" Classes="ribbon-today" IsVisible="{Binding IsToday}" />
                      <Border Classes="ribbon-win" Height="{Binding WinHeight}" />
                      <Border Grid.Row="1" Classes="ribbon-loss" Height="{Binding LossHeight}" />
                      <Border Grid.RowSpan="2" Classes="ribbon-tick" IsVisible="{Binding IsUpcomingGame}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
            <ItemsControl ItemsSource="{Binding RibbonPhases}">
              <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:RibbonPhase">
                  <Setter Property="theming:SpanPanel.Span" Value="{Binding Span}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <theming:SpanPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RibbonPhase">
                  <Border Classes="ribbon-label" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Dates}">
                    <StackPanel>
                      <TextBlock Classes="eyebrow" Classes.accent="{Binding IsCurrent}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="faint tiny" Text="{Binding Days}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Dashboard: the table on the left, the games on the right. -->
      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="24" IsVisible="{Binding HasSeason}">

        <StackPanel Spacing="18">
          <!-- The viewed team's month: one square a day, results ruled green or red, today ringed. -->
          <StackPanel Spacing="8" IsVisible="{Binding HasViewedTeam}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Button Content="‹" Command="{Binding PreviousMonthCommand}" IsEnabled="{Binding CanGoToPreviousMonth}" Padding="12,4" ToolTip.Tip="Previous month" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="{Binding MonthTitle}" VerticalAlignment="Center" />
                <TextBlock Classes="dim" Text="{Binding MonthSummary}" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="2" Content="›" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanGoToNextMonth}" Padding="12,4" ToolTip.Tip="Next month" />
            </Grid>
            <UniformGrid Columns="7" Classes="thead" Margin="2,0">
              <TextBlock Text="Mon" Classes="eyebrow" />
              <TextBlock Text="Tue" Classes="eyebrow" />
              <TextBlock Text="Wed" Classes="eyebrow" />
              <TextBlock Text="Thu" Classes="eyebrow" />
              <TextBlock Text="Fri" Classes="eyebrow" />
              <TextBlock Text="Sat" Classes="eyebrow" />
              <TextBlock Text="Sun" Classes="eyebrow" />
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding MonthCells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDayCell">
                  <Button
                    Classes="daycell"
                    Classes.off="{Binding !IsInSeason}"
                    Classes.game="{Binding HasGame}"
                    Classes.today="{Binding IsToday}"
                    Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).ShowGameCommand}"
                    CommandParameter="{Binding GameId}"
                    ToolTip.Tip="{Binding Tip}">
                    <Grid ColumnDefinitions="Auto,*" Background="{Binding Opponent, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=wash, FallbackValue={x:Null}}">
                      <Border Classes="result-rule" Classes.win="{Binding IsWin}" Classes.loss="{Binding IsLoss}" IsVisible="{Binding HasGame}" CornerRadius="2,0,0,2" />
                      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="6,4,6,4">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Text="{Binding DayOfMonth}" Classes="num small" Classes.faint="{Binding !HasGame}" />
                          <TextBlock Grid.Column="1" Text="Today" Classes="eyebrow accent" HorizontalAlignment="Right" IsVisible="{Binding IsToday}" />
                          <TextBlock Grid.Column="1" Text="{Binding Result}" Classes="num small" Classes.good="{Binding IsWin}" Classes.bad="{Binding IsLoss}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding HasGame}">
                          <Panel Classes="badge small">
                            <Border Classes="badge-plate" Background="{Binding Opponent, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=plate, FallbackValue={x:Null}}" IsVisible="{Binding !Opponent.HasLogo, FallbackValue=False}" />
                            <Image Source="{Binding Opponent.LogoPath, Converter={x:Static conv:ImagePathConverter.Instance}, FallbackValue={x:Null}}" IsVisible="{Binding Opponent.HasLogo, FallbackValue=False}" />
                          </Panel>
                          <TextBlock Text="{Binding Matchup}" Classes="num" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Marker}" Classes="tiny accent" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding !HasGame}" />
                        <TextBlock Grid.Row="2" Text="{Binding Detail}" Classes="num small" Classes.good="{Binding IsWin}" Classes.bad="{Binding IsLoss}" Classes.faint="{Binding IsUpcoming}" />
                      </Grid>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Select any game to open it: a preview of both rotations before tip-off, the box score after. Upcoming games show the opponent's record." Classes="faint tiny" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="Standings" />
            <Grid Classes="thead" ColumnDefinitions="30,*,150,62,50,56,62,52">
              <TextBlock Text="#" />
              <TextBlock Grid.Column="1" Text="Team" />
              <TextBlock Grid.Column="2" Text="Group" />
              <TextBlock Grid.Column="3" Text="W-L" />
              <TextBlock Grid.Column="4" Text="Div" />
              <TextBlock Grid.Column="5" Text="Conf" />
              <TextBlock Grid.Column="6" Text="Diff" />
              <TextBlock Grid.Column="7" Text="PF" />
            </Grid>
            <ItemsControl Classes="table" ItemsSource="{Binding Standings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StandingsRowDisplay">
                  <Grid ColumnDefinitions="30,*,150,62,50,56,62,52" Height="30" Classes.viewed="{Binding IsViewedTeam}">
                    <TextBlock Text="{Binding Position}" VerticalAlignment="Center" Classes="faint num" />
                    <TextBlock Grid.Column="1" Text="{Binding TeamName}" VerticalAlignment="Center" Classes="strong" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Group}" VerticalAlignment="Center" Classes="dim tiny" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Record}" VerticalAlignment="Center" Classes="num" />
                    <TextBlock Grid.Column="4" Text="{Binding DivisionRecord}" VerticalAlignment="Center" Classes="dim small" />
                    <TextBlock Grid.Column="5" Text="{Binding ConferenceRecord}" VerticalAlignment="Center" Classes="dim small" />
                    <TextBlock Grid.Column="6" Text="{Binding PointDifferential}" VerticalAlignment="Center" Classes="num" />
                    <TextBlock Grid.Column="7" Text="{Binding PointsFor}" VerticalAlignment="Center" Classes="dim small" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TieBreakLine}" Classes="faint tiny" TextWrapping="Wrap" />
          </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="18">
          <!-- The road ahead: the viewed team's next games, and the shape of the stretch after them. -->
          <StackPanel Spacing="10" IsVisible="{Binding HasViewedTeam}">
            <TextBlock Classes="section" Text="Road ahead" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
              <StackPanel>
                <TextBlock Classes="eyebrow" Text="{Binding StretchLabel}" />
                <TextBlock Classes="num" Text="{Binding StretchVenues}" FontSize="20" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="eyebrow" Text="Back-to-backs" />
                <TextBlock Classes="num" Text="{Binding StretchBackToBacks}" FontSize="20" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="eyebrow" Text="Opponents" ToolTip.Tip="Combined winning percentage of the opponents in this stretch" />
                <TextBlock Classes="num" Text="{Binding StretchOpponents}" FontSize="20" />
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding RoadAhead}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MatchupCard">
                  <Button
                    Classes="cardbtn"
                    Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).ShowGameCommand}"
                    CommandParameter="{Binding GameId}"
                    ToolTip.Tip="Open this game">
                  <Border Classes="matchup" Classes.home="{Binding IsHome}">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                      <Border Grid.ColumnSpan="3" Grid.RowSpan="3" Margin="-14,-10" Background="{Binding Opponent, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=wash}" />
                      <Panel Grid.RowSpan="2" Classes="badge" VerticalAlignment="Center">
                        <Border Classes="badge-plate" Background="{Binding Opponent, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=plate}" IsVisible="{Binding !Opponent.HasLogo}">
                          <TextBlock Text="{Binding Opponent.Initials}" Foreground="{Binding Opponent, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=ink}" />
                        </Border>
                        <Image Source="{Binding Opponent.LogoPath, Converter={x:Static conv:ImagePathConverter.Instance}}" IsVisible="{Binding Opponent.HasLogo}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="eyebrow" Classes.accent="{Binding IsHome}" Text="{Binding When}" />
                        <TextBlock Classes="eyebrow" Classes.accent="{Binding IsHome}" Text="{Binding Venue}" />
                        <TextBlock Classes="faint tiny" Text="{Binding DayLine}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="h3" Text="{Binding OpponentName}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Classes="num" Text="{Binding OpponentRecord}" HorizontalAlignment="Right" FontSize="20" />
                        <ProgressBar
                          Classes="attr"
                          Width="72"
                          Minimum="0"
                          Maximum="100"
                          Value="{Binding OpponentWinPercent}"
                          Foreground="{StaticResource TextDimBrush}"
                          IsVisible="{Binding HasOpponentForm}"
                          ToolTip.Tip="Opponent's winning percentage" />
                      </StackPanel>
                      <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <TextBlock Classes="dim tiny" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding OpponentDetail}" />
                          <Run Text=" · " />
                          <Run Text="{Binding SeriesLine}" />
                        </TextBlock>
                        <Border Grid.Column="1" Classes="pill" Classes.warn="{Binding IsBackToBack}">
                          <TextBlock Text="{Binding RestLine}" />
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding RoadAheadEmptyMessage}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding !HasRoadAhead}" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="Recent results" />
            <TextBlock Text="Select a game to open it." Classes="faint tiny" />
            <ListBox x:Name="RecentResults" ItemsSource="{Binding RecentResults}" SelectedItem="{Binding SelectedFixture}" MaxHeight="260">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FixtureRow">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Matchup}" Classes="strong" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Score}" Classes="num" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Day}" Classes="faint tiny" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding HasNoViewedTeam}">
            <TextBlock Classes="section" Text="Next up" />
            <ItemsControl Classes="table" ItemsSource="{Binding UpcomingFixtures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FixtureRow">
                  <Grid ColumnDefinitions="*,Auto" Height="30">
                    <TextBlock Text="{Binding Matchup}" VerticalAlignment="Center" Classes="small strong" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Day}" VerticalAlignment="Center" Classes="faint tiny" Margin="12,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="8" IsVisible="{Binding HasWarnings}">
        <TextBlock Classes="section" Text="Warnings" />
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SeasonFindingRow">
              <Border Classes="callout warn" Margin="0,0,0,8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Scope}" Classes="strong small" />
                  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Code}" Classes="code" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding HasNotes}">
        <TextBlock Classes="section" Text="Rules this league does not state" />
        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SeasonFindingRow">
              <StackPanel Spacing="1" Margin="0,0,0,8">
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Classes="dim" />
                <TextBlock Text="{Binding Code}" Classes="code" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  <!-- The game sheet: one game, both teams side by side. Opens over the calendar from any game on it. -->
  <Panel IsVisible="{Binding IsSheetOpen}">
    <Button Classes="scrim" Command="{Binding CloseGameCommand}" ToolTip.Tip="Close" />
    <Border Classes="sheet" DataContext="{Binding Sheet}" x:DataType="vm:GameSheet">
      <ScrollViewer>
        <StackPanel Spacing="18" Margin="24,20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Status}" Classes="eyebrow accent" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DayLine}" Classes="dim small" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).CloseGameCommand}" />
          </Grid>

          <!-- Scoreboard: away on the left, home on the right, the score or the venue mark between them. -->
          <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="24">
            <Border Margin="-24,-8,0,-8" Background="{Binding Away.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=wash-left}" />
            <Border Grid.Column="2" Margin="0,-8,-24,-8" Background="{Binding Home.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=wash}" />
                  <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                    <Panel Classes="badge large">
                      <Border Classes="badge-plate" Background="{Binding Away.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=plate}" IsVisible="{Binding !Away.Art.HasLogo}">
                        <TextBlock Text="{Binding Away.Art.Initials}" Foreground="{Binding Away.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=ink}" />
                      </Border>
                      <Image Source="{Binding Away.Art.LogoPath, Converter={x:Static conv:ImagePathConverter.Instance}}" IsVisible="{Binding Away.Art.HasLogo}" />
                    </Panel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                      <TextBlock Text="Away" Classes="eyebrow" HorizontalAlignment="Left" />
                      <TextBlock Text="{Binding Away.TeamName}" Classes="h2" HorizontalAlignment="Left" TextWrapping="Wrap" TextAlignment="Left" />
                      <TextBlock Text="{Binding Away.Record}" Classes="num dim" HorizontalAlignment="Left" />
                    </StackPanel>
                  </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" IsVisible="{Binding IsFinal}">
                <TextBlock Text="{Binding Away.Score}" Classes="display" Classes.dim="{Binding !Away.IsWinner}" />
                <TextBlock Text="–" Classes="display faint" />
                <TextBlock Text="{Binding Home.Score}" Classes="display" Classes.dim="{Binding !Home.IsWinner}" />
              </StackPanel>
              <TextBlock Text="@" Classes="display faint" HorizontalAlignment="Center" IsVisible="{Binding IsPreview}" />
            </StackPanel>
            <Panel Grid.Column="2">
                  <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="Home" Classes="eyebrow" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding Home.TeamName}" Classes="h2" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                      <TextBlock Text="{Binding Home.Record}" Classes="num dim" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Panel Classes="badge large">
                      <Border Classes="badge-plate" Background="{Binding Home.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=plate}" IsVisible="{Binding !Home.Art.HasLogo}">
                        <TextBlock Text="{Binding Home.Art.Initials}" Foreground="{Binding Home.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=ink}" />
                      </Border>
                      <Image Source="{Binding Home.Art.LogoPath, Converter={x:Static conv:ImagePathConverter.Instance}}" IsVisible="{Binding Home.Art.HasLogo}" />
                    </Panel>
                  </StackPanel>
            </Panel>
          </Grid>

          <!-- The tale of the tape. -->
          <Border Classes="panel">
            <Grid ColumnDefinitions="*,160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
              <TextBlock Grid.Row="0" Text="{Binding Away.PointsFor}" Classes="num" HorizontalAlignment="Right" FontSize="18" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="Points per game" Classes="eyebrow" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Home.PointsFor}" Classes="num" HorizontalAlignment="Left" FontSize="18" />
              <TextBlock Grid.Row="1" Text="{Binding Away.PointsAgainst}" Classes="num" HorizontalAlignment="Right" FontSize="18" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="Allowed per game" Classes="eyebrow" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Home.PointsAgainst}" Classes="num" HorizontalAlignment="Left" FontSize="18" />
              <TextBlock Grid.Row="2" Text="{Binding Away.Differential}" Classes="num" HorizontalAlignment="Right" FontSize="18" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Margin per game" Classes="eyebrow" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Home.Differential}" Classes="num" HorizontalAlignment="Left" FontSize="18" />
              <Panel Grid.Row="3">
                      <ItemsControl ItemsSource="{Binding Away.Form}" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FormChip">
                            <Border Classes="form" Classes.win="{Binding IsWin}" ToolTip.Tip="{Binding Tip}">
                              <TextBlock Text="{Binding Letter}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                <TextBlock Text="No games yet" Classes="faint tiny" HorizontalAlignment="Right" IsVisible="{Binding !Away.HasForm}" />
              </Panel>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="Last 5 games" Classes="eyebrow" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Panel Grid.Row="3" Grid.Column="2">
                      <ItemsControl ItemsSource="{Binding Home.Form}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FormChip">
                            <Border Classes="form" Classes.win="{Binding IsWin}" ToolTip.Tip="{Binding Tip}">
                              <TextBlock Text="{Binding Letter}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                <TextBlock Text="No games yet" Classes="faint tiny" HorizontalAlignment="Left" IsVisible="{Binding !Home.HasForm}" />
              </Panel>
            </Grid>
          </Border>

          <!-- The season series: every other meeting, played or to come. -->
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="Season series" />
            <TextBlock Text="First meeting this season, and the only one scheduled." Classes="dim" IsVisible="{Binding !HasMeetings}" />
            <ItemsControl ItemsSource="{Binding Meetings}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MeetingRow">
                  <Button
                    Classes="meeting"
                    Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).ShowGameCommand}"
                    CommandParameter="{Binding GameId}"
                    ToolTip.Tip="Open this meeting">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding DayLine}" Classes="faint tiny" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Matchup}" Classes="small strong" />
                        <TextBlock Text="{Binding Score}" Classes="num small" Classes.faint="{Binding !IsPlayed}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Winner}" Classes="dim tiny" IsVisible="{Binding IsPlayed}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The two line-ups, side by side. -->
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="{Binding LineupHeading}" />
            <TextBlock Text="{Binding LineupNote}" Classes="faint tiny" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Panel Classes="badge small">
                        <Border Classes="badge-plate" Background="{Binding Away.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=plate}" IsVisible="{Binding !Away.Art.HasLogo}" />
                        <Image Source="{Binding Away.Art.LogoPath, Converter={x:Static conv:ImagePathConverter.Instance}}" IsVisible="{Binding Away.Art.HasLogo}" />
                      </Panel>
                      <TextBlock Text="{Binding Away.TeamName}" Classes="h3" />
                    </StackPanel>
                    <Grid Classes="thead" ColumnDefinitions="34,*,42,38,40,40,40,44" IsVisible="{Binding IsPreview}">
                      <TextBlock Text="Pos" />
                      <TextBlock Grid.Column="1" Text="Player" />
                      <TextBlock Grid.Column="2" Text="OVR" />
                      <TextBlock Grid.Column="3" Text="MIN" />
                      <TextBlock Grid.Column="4" Text="PPG" />
                      <TextBlock Grid.Column="5" Text="RPG" />
                      <TextBlock Grid.Column="6" Text="APG" />
                      <TextBlock Grid.Column="7" Text="L5 PTS" />
                    </Grid>
                    <Grid Classes="thead" ColumnDefinitions="34,*,42,38,40,40,40,44" IsVisible="{Binding IsFinal}">
                      <TextBlock Text="Pos" />
                      <TextBlock Grid.Column="1" Text="Player" />
                      <TextBlock Grid.Column="2" Text="OVR" />
                      <TextBlock Grid.Column="3" Text="MIN" />
                      <TextBlock Grid.Column="4" Text="PTS" />
                      <TextBlock Grid.Column="5" Text="REB" />
                      <TextBlock Grid.Column="6" Text="AST" />
                      <TextBlock Grid.Column="7" Text="PPG" />
                    </Grid>
                    <TextBlock Text="Starters" Classes="eyebrow" Margin="0,4,0,0" IsVisible="{Binding Away.HasLineup}" />
                    <ItemsControl Classes="table" ItemsSource="{Binding Away.Starters}" ItemTemplate="{StaticResource LineupRowTemplate}" />
                    <TextBlock Text="Bench" Classes="eyebrow" Margin="0,6,0,0" IsVisible="{Binding Away.HasLineup}" />
                    <ItemsControl Classes="table" ItemsSource="{Binding Away.Bench}" ItemTemplate="{StaticResource LineupRowTemplate}" />
                    <TextBlock Text="{Binding Away.LineupNote}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding !Away.HasLineup}" />
                  </StackPanel>
              <Panel Grid.Column="1">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Panel Classes="badge small">
                        <Border Classes="badge-plate" Background="{Binding Home.Art, Converter={x:Static conv:TeamShadeConverter.Instance}, ConverterParameter=plate}" IsVisible="{Binding !Home.Art.HasLogo}" />
                        <Image Source="{Binding Home.Art.LogoPath, Converter={x:Static conv:ImagePathConverter.Instance}}" IsVisible="{Binding Home.Art.HasLogo}" />
                      </Panel>
                      <TextBlock Text="{Binding Home.TeamName}" Classes="h3" />
                    </StackPanel>
                    <Grid Classes="thead" ColumnDefinitions="34,*,42,38,40,40,40,44" IsVisible="{Binding IsPreview}">
                      <TextBlock Text="Pos" />
                      <TextBlock Grid.Column="1" Text="Player" />
                      <TextBlock Grid.Column="2" Text="OVR" />
                      <TextBlock Grid.Column="3" Text="MIN" />
                      <TextBlock Grid.Column="4" Text="PPG" />
                      <TextBlock Grid.Column="5" Text="RPG" />
                      <TextBlock Grid.Column="6" Text="APG" />
                      <TextBlock Grid.Column="7" Text="L5 PTS" />
                    </Grid>
                    <Grid Classes="thead" ColumnDefinitions="34,*,42,38,40,40,40,44" IsVisible="{Binding IsFinal}">
                      <TextBlock Text="Pos" />
                      <TextBlock Grid.Column="1" Text="Player" />
                      <TextBlock Grid.Column="2" Text="OVR" />
                      <TextBlock Grid.Column="3" Text="MIN" />
                      <TextBlock Grid.Column="4" Text="PTS" />
                      <TextBlock Grid.Column="5" Text="REB" />
                      <TextBlock Grid.Column="6" Text="AST" />
                      <TextBlock Grid.Column="7" Text="PPG" />
                    </Grid>
                    <TextBlock Text="Starters" Classes="eyebrow" Margin="0,4,0,0" IsVisible="{Binding Home.HasLineup}" />
                    <ItemsControl Classes="table" ItemsSource="{Binding Home.Starters}" ItemTemplate="{StaticResource LineupRowTemplate}" />
                    <TextBlock Text="Bench" Classes="eyebrow" Margin="0,6,0,0" IsVisible="{Binding Home.HasLineup}" />
                    <ItemsControl Classes="table" ItemsSource="{Binding Home.Bench}" ItemTemplate="{StaticResource LineupRowTemplate}" />
                    <TextBlock Text="{Binding Home.LineupNote}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding !Home.HasLineup}" />
                  </StackPanel>
              </Panel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Panel>
  </Panel>
</UserControl>
