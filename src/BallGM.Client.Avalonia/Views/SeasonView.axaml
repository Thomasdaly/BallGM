<UserControl
  x:Class="BallGM.Client.Avalonia.Views.SeasonView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  xmlns:views="clr-namespace:BallGM.Client.Avalonia.Views"
  xmlns:app="clr-namespace:BallGM.Application.Seasons;assembly=BallGM.Application"
  xmlns:theming="clr-namespace:BallGM.Client.Avalonia.Theming"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls"
  x:DataType="vm:SeasonViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseGameCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Resources>
    <!-- The season series: every other meeting, played or to come. -->
    <DataTemplate x:Key="MeetingsTemplate" x:DataType="vm:GameSheet">
      <Panel>
        <TextBlock Text="First meeting this season, and the only one scheduled." Classes="body secondary" IsVisible="{Binding !HasMeetings}" />
        <ItemsControl ItemsSource="{Binding Meetings}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="{StaticResource Space8}" LineSpacing="{StaticResource Space8}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MeetingRow">
              <Button Classes="matchup-row" Theme="{StaticResource BareButton}" Padding="{StaticResource Pad12}"
                      Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).ShowGameCommand}" CommandParameter="{Binding GameId}"
                      AutomationProperties.Name="{Binding Matchup, StringFormat='Open the meeting {0}'}">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DayLine}" Classes="caption" />
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <TextBlock Text="{Binding Matchup}" Classes="body-strong" />
                    <TextBlock Text="{Binding Score}" Classes="table" Classes.secondary="{Binding !IsPlayed}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Winner}" Classes="caption" IsVisible="{Binding IsPlayed}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </DataTemplate>
  </UserControl.Resources>
  <Panel>
  <!-- S12 Schedule / calendar, template T8: the month as game chips or a list; games open their sheet. -->
  <ScrollViewer Name="CalendarScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsSheetOpen}">
    <StackPanel Spacing="{StaticResource Space16}">

      <ctl:EmptyState IconKey="Icon.Calendar" Headline="No season under way" Message="{Binding PhaseLine}" ActionText="Start season" ActionCommand="{Binding StartSeasonCommand}" IsVisible="{Binding HasNoSeason}" />

      <ctl:Banner Text="{Binding Message}" Kind="Info" IsVisible="{Binding HasMessage}" />

      <!-- Where the league is, and the controls that move it (Continue in the header does the same). -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space16}" IsVisible="{Binding HasSeason}">
        <StackPanel Spacing="{StaticResource Space4}" VerticalAlignment="Center">
          <TextBlock Classes="h3" Text="{Binding Headline, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
          <TextBlock Text="{Binding AdvancePreview}" Classes="body secondary wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
          <TextBlock Text="DAYS" Classes="label-caps" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding AdvanceOptions}" SelectedItem="{Binding AdvanceDays}" MinWidth="88" AutomationProperties.Name="Days to advance" />
          <Button Classes="secondary" Content="Advance" Command="{Binding AdvanceCommand}" />
          <Button Classes="ghost" Content="To end of season" Command="{Binding AdvanceToEndCommand}" />
        </StackPanel>
      </Grid>

      <!-- The viewed team's season at a glance. -->
      <Grid ColumnDefinitions="*,*,*,2*,2*" ColumnSpacing="{StaticResource Space16}" IsVisible="{Binding HasViewedTeam}">
        <ctl:Tile Classes="compact">
          <ctl:StatTile Value="{Binding TeamRecord}" Label="Record" />
        </ctl:Tile>
        <ctl:Tile Grid.Column="1" Classes="compact">
          <ctl:StatTile Value="{Binding TeamStreak}" Label="Streak" />
        </ctl:Tile>
        <ctl:Tile Grid.Column="2" Classes="compact">
          <ctl:StatTile Value="{Binding TeamGamesRemaining}" Label="Games left" />
        </ctl:Tile>
        <ctl:Tile Grid.Column="3" Classes="compact">
          <StackPanel Spacing="{StaticResource Space8}">
            <TextBlock Text="LAST FIVE" Classes="label-caps" />
            <ctl:WinLossStrip Results="{Binding FormResults}" IsVisible="{Binding HasForm}" />
            <TextBlock Text="No games yet" Classes="body secondary" IsVisible="{Binding !HasForm}" />
          </StackPanel>
        </ctl:Tile>
        <ctl:Tile Grid.Column="4" Classes="compact">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space16}">
            <ctl:StatTile Value="{Binding StretchVenues}" Label="{Binding StretchLabel}" />
            <ctl:StatTile Grid.Column="1" Value="{Binding StretchBackToBacks}" Label="Back-to-backs" />
            <ctl:StatTile Grid.Column="2" Value="{Binding StretchOpponents}" Label="Opp win %" ToolTip.Tip="Combined winning percentage of the opponents in this stretch" />
          </Grid>
        </ctl:Tile>
      </Grid>

      <!-- The season ribbon: every day, wins above the line and losses below it, by margin. -->
      <ctl:Tile Title="{Binding TeamSeasonHeadline}" IsVisible="{Binding HasViewedTeam}">
        <StackPanel>
          <Panel Height="52">
            <ItemsControl ItemsSource="{Binding RibbonPhases}">
              <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:RibbonPhase">
                  <Setter Property="theming:SpanPanel.Span" Value="{Binding Span}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <theming:SpanPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RibbonPhase">
                  <Border Classes="ribbon-phase" Classes.alt="{Binding IsAlternate}" Classes.current="{Binding IsCurrent}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{StaticResource StrokeBrush}" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding RibbonDays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <theming:SpanPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RibbonDay">
                  <Grid RowDefinitions="*,*" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                    <Border Grid.RowSpan="2" Classes="ribbon-today" IsVisible="{Binding IsToday}" />
                    <Border Classes="ribbon-win" Height="{Binding WinHeight}" />
                    <Border Grid.Row="1" Classes="ribbon-loss" Height="{Binding LossHeight}" />
                    <Border Grid.RowSpan="2" Classes="ribbon-tick" IsVisible="{Binding IsUpcomingGame}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
          <ItemsControl ItemsSource="{Binding RibbonPhases}">
            <ItemsControl.Styles>
              <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:RibbonPhase">
                <Setter Property="theming:SpanPanel.Span" Value="{Binding Span}" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <theming:SpanPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RibbonPhase">
                <StackPanel Margin="{StaticResource PadH8}" ToolTip.Tip="{Binding Dates}">
                  <TextBlock Classes="label-caps trim" Text="{Binding Name, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
                  <TextBlock Classes="caption trim" Text="{Binding Days}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ctl:Tile>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="{StaticResource Space16}" IsVisible="{Binding HasSeason}">
        <!-- The viewed team's month. -->
        <ctl:Tile VerticalAlignment="Top" IsVisible="{Binding HasViewedTeam}">
          <StackPanel Spacing="{StaticResource Space12}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource Space8}">
              <Button Classes="icon" Command="{Binding PreviousMonthCommand}" IsEnabled="{Binding CanGoToPreviousMonth}" ToolTip.Tip="Previous month" AutomationProperties.Name="Previous month">
                <PathIcon Data="{StaticResource Icon.Back}" />
              </Button>
              <Button Grid.Column="1" Classes="icon" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanGoToNextMonth}" ToolTip.Tip="Next month" AutomationProperties.Name="Next month">
                <PathIcon Data="{StaticResource Icon.Forward}" />
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center" Margin="{StaticResource GapLeft8}">
                <TextBlock Classes="h2" Text="{Binding MonthTitle, Converter={x:Static conv:UpperCaseConverter.Instance}}" VerticalAlignment="Center" />
                <TextBlock Classes="body secondary" Text="{Binding MonthSummary}" VerticalAlignment="Center" />
              </StackPanel>
              <ctl:SegmentedControl Grid.Column="3" ItemsSource="{Binding ViewOptions}" SelectedIndex="{Binding ViewIndex}" VerticalAlignment="Center" AutomationProperties.Name="Calendar view" />
            </Grid>
            <ctl:CalendarMonth Days="{Binding CalendarDays}" OpenGameCommand="{Binding ShowGameCommand}" IsVisible="{Binding IsMonthView}" />
            <ctl:DataTable Height="420" Columns="{Binding MonthListColumns}" Rows="{Binding MonthListRows}" OpenRowCommand="{Binding ShowGameCommand}" EmptyHeadline="No games this month" EmptyMessage="Use the arrows to move to a month with games." IsVisible="{Binding IsListView}" />
            <TextBlock Text="Select any game to open it: a preview before tip-off, the box score after. Upcoming games show the opponent's record." Classes="caption wrap" />
          </StackPanel>
        </ctl:Tile>
        <ctl:EmptyState IconKey="Icon.Team" Headline="No team to follow" Message="Pick a team to see its month and road ahead." IsVisible="{Binding HasNoViewedTeam}" />

        <StackPanel Grid.Column="1" Spacing="{StaticResource Space16}">
          <ctl:Tile Title="Road ahead" IsVisible="{Binding HasViewedTeam}">
            <StackPanel Spacing="{StaticResource Space8}">
              <ItemsControl ItemsSource="{Binding RoadAhead}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource Space8}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MatchupCard">
                    <Button Classes="matchup-row" Theme="{StaticResource BareButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="{StaticResource Pad12}"
                            Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).ShowGameCommand}" CommandParameter="{Binding GameId}"
                            AutomationProperties.Name="{Binding OpponentName, StringFormat='Open game against {0}'}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space12}">
                        <ctl:TeamLogo TeamId="{Binding OpponentId}" TeamName="{Binding OpponentName}" Size="40" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="label-caps trim" Text="{Binding Eyebrow}" ToolTip.Tip="{Binding DayLine}" />
                          <TextBlock Classes="body-strong trim" Text="{Binding OpponentName}" />
                          <TextBlock Classes="caption trim" Text="{Binding DetailLine}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="{StaticResource Space4}" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Classes="stat-m" Text="{Binding OpponentRecord}" HorizontalAlignment="Right" />
                          <ctl:StatusChip Text="{Binding RestLine}" Kind="{Binding RestKind}" HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding RoadAheadEmptyMessage}" Classes="body secondary wrap" IsVisible="{Binding !HasRoadAhead}" />
            </StackPanel>
          </ctl:Tile>

          <ctl:Tile Title="Recent results">
            <StackPanel Spacing="{StaticResource Space8}">
              <ListBox x:Name="RecentResults" Classes="results" ItemsSource="{Binding RecentResults}" SelectedItem="{Binding SelectedFixture}" MaxHeight="320" AutomationProperties.Name="Recent results">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FixtureRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space8}" RowSpacing="2" ToolTip.Tip="{Binding Day}">
                      <ctl:TeamLogo TeamId="{Binding AwayTeamId}" TeamName="{Binding AwayTeam}" Size="20" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding AwayTeam}" Classes="body trim" Classes.body-strong="{Binding AwayWon}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding AwayPoints}" Classes="table" Classes.body-strong="{Binding AwayWon}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <ctl:TeamLogo Grid.Row="1" TeamId="{Binding HomeTeamId}" TeamName="{Binding HomeTeam}" Size="20" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HomeTeam}" Classes="body trim" Classes.body-strong="{Binding HomeWon}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HomePoints}" Classes="table" Classes.body-strong="{Binding HomeWon}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="No games played in the last few days." Classes="body secondary" IsVisible="{Binding !HasRecentResults}" />
              <TextBlock Text="Select a result to open its box score." Classes="caption" />
            </StackPanel>
          </ctl:Tile>

          <ctl:Tile Title="Next up" IsVisible="{Binding HasNoViewedTeam}">
            <ItemsControl ItemsSource="{Binding UpcomingFixtures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FixtureRow">
                  <Grid ColumnDefinitions="*,Auto" Height="{StaticResource RowHeight}">
                    <TextBlock Text="{Binding Matchup}" Classes="body-strong trim" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Day}" Classes="caption" VerticalAlignment="Center" Margin="{StaticResource GapLeft8}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ctl:Tile>
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{StaticResource Space8}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SeasonFindingRow">
            <ctl:Banner Text="{Binding Explanation}" Kind="Warning" ToolTip.Tip="{Binding Code}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ctl:Tile Title="Rules this league does not state" IsVisible="{Binding HasNotes}">
        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SeasonFindingRow">
              <StackPanel Spacing="2" Margin="{StaticResource GapBottom8}">
                <TextBlock Text="{Binding Explanation}" Classes="body secondary wrap" />
                <TextBlock Text="{Binding Code}" Classes="caption" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ctl:Tile>
    </StackPanel>
  </ScrollViewer>
  <!-- S15 pre-game / S17 box score, template T7: opened from any game; Back or Escape returns to the calendar. -->
  <ScrollViewer Name="SheetScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsSheetOpen}">
    <StackPanel Spacing="{StaticResource Space16}" DataContext="{Binding Sheet}" x:DataType="vm:GameSheet">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space16}">
        <Button Classes="secondary" Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).CloseGameCommand}" AutomationProperties.Name="Back to the schedule">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <PathIcon Data="{StaticResource Icon.Back}" Classes="small" />
            <TextBlock Text="Schedule" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
          <TextBlock Text="{Binding Headline}" Classes="h3" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DayLine}" Classes="body secondary" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="2" Classes="primary" Content="SIM GAME" Command="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).SimGameCommand}"
                IsVisible="{Binding $parent[UserControl].((vm:SeasonViewModel)DataContext).CanSimGame}" ToolTip.Tip="Play today's games and open this one's box score" />
      </Grid>

      <!-- Matchup hero: both teams' colours meet in the middle, the score bug over them. -->
      <Border CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True">
        <Grid ColumnDefinitions="*,*">
          <Border Classes="matchup-away" theming:TeamScope.TeamId="{Binding Away.TeamId}">
            <Border Background="{DynamicResource TeamPrimaryRawBrush}" />
          </Border>
          <Border Grid.Column="1" theming:TeamScope.TeamId="{Binding Home.TeamId}">
            <Border Background="{DynamicResource TeamPrimaryRawBrush}" />
          </Border>
          <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,*" Margin="{StaticResource Pad24}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space16}" theming:TeamScope.TeamId="{Binding Away.TeamId}">
              <ctl:TeamLogo TeamId="{Binding Away.TeamId}" TeamName="{Binding Away.TeamName}" Size="96" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space4}">
                <TextBlock Text="AWAY" Classes="caps" Foreground="{DynamicResource OnPrimaryRawBrush}" />
                <TextBlock Text="{Binding Away.TeamName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="h2 wrap" Foreground="{DynamicResource OnPrimaryRawBrush}" MaxWidth="360" />
                <TextBlock Text="{Binding Away.Record}" Classes="body-strong" Foreground="{DynamicResource OnPrimaryRawBrush}" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource ScrimBrush}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Pad16}" VerticalAlignment="Center">
              <ctl:ScoreBug Away="{Binding BugAway}" Home="{Binding BugHome}" Status="{Binding BugStatus}" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space16}" HorizontalAlignment="Right" theming:TeamScope.TeamId="{Binding Home.TeamId}">
              <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space4}">
                <TextBlock Text="HOME" Classes="caps" Foreground="{DynamicResource OnPrimaryRawBrush}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Home.TeamName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="h2 wrap" Foreground="{DynamicResource OnPrimaryRawBrush}" TextAlignment="Right" HorizontalAlignment="Right" MaxWidth="360" />
                <TextBlock Text="{Binding Home.Record}" Classes="body-strong" Foreground="{DynamicResource OnPrimaryRawBrush}" HorizontalAlignment="Right" />
              </StackPanel>
              <ctl:TeamLogo TeamId="{Binding Home.TeamId}" TeamName="{Binding Home.TeamName}" Size="96" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Top performers (finals only). -->
      <ItemsControl ItemsSource="{Binding TopPerformers}" IsVisible="{Binding HasTopPerformers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" ColumnSpacing="{StaticResource Space16}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TopPerformer">
            <ctl:Tile Classes="compact">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space12}">
                <ctl:PlayerHeadshot PlayerId="{Binding PlayerId}" PlayerName="{Binding Name}" Size="Medium" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <ctl:TeamLogo TeamId="{Binding TeamId}" TeamName="{Binding TeamName}" Size="20" VerticalAlignment="Center" />
                    <TextBlock Text="TOP PERFORMER" Classes="label-caps" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" Classes="body-strong trim" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Text="{Binding Line}" Classes="table" />
                </StackPanel>
                <views:RatingPill Grid.Column="2" DataContext="{Binding Rating}" VerticalAlignment="Center" />
              </Grid>
            </ctl:Tile>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space16}">
        <!-- The tale of the tape. -->
        <ctl:Tile Title="Tale of the tape">
          <Grid ColumnDefinitions="*,180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space8}" ColumnSpacing="{StaticResource Space16}">
            <TextBlock Text="{Binding Away.PointsFor}" Classes="stat-m" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="1" Text="POINTS PER GAME" Classes="label-caps" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Home.PointsFor}" Classes="stat-m" />
            <TextBlock Grid.Row="1" Text="{Binding Away.PointsAgainst}" Classes="stat-m" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="ALLOWED PER GAME" Classes="label-caps" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Home.PointsAgainst}" Classes="stat-m" />
            <TextBlock Grid.Row="2" Text="{Binding Away.Differential}" Classes="stat-m" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="MARGIN PER GAME" Classes="label-caps" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Home.Differential}" Classes="stat-m" />
            <Panel Grid.Row="3">
              <ctl:WinLossStrip Results="{Binding Away.FormResults}" HorizontalAlignment="Right" IsVisible="{Binding Away.HasForm}" />
              <TextBlock Text="No games yet" Classes="caption" HorizontalAlignment="Right" IsVisible="{Binding !Away.HasForm}" />
            </Panel>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="LAST 5 GAMES" Classes="label-caps" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Panel Grid.Row="3" Grid.Column="2">
              <ctl:WinLossStrip Results="{Binding Home.FormResults}" HorizontalAlignment="Left" IsVisible="{Binding Home.HasForm}" />
              <TextBlock Text="No games yet" Classes="caption" IsVisible="{Binding !Home.HasForm}" />
            </Panel>
          </Grid>
        </ctl:Tile>

        <!-- A final's four factors; before tip-off, the season series in its place. -->
        <ctl:Tile Grid.Column="1" Title="Four factors" IsVisible="{Binding HasFourFactors}">
          <StackPanel Spacing="{StaticResource Space8}">
            <TextBlock Text="The better figure in each row is brighter; for turnover %, lower is better." Classes="caption wrap" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding FourFactors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FactorRow">
                  <Grid ColumnDefinitions="*,180,*" ColumnSpacing="{StaticResource Space16}" Height="32" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Away}" Classes="table" Classes.body-strong="{Binding !AwayTrails}" Classes.secondary="{Binding AwayTrails}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Label, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="label-caps" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Home}" Classes="table" Classes.body-strong="{Binding !HomeTrails}" Classes.secondary="{Binding HomeTrails}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ctl:Tile>
        <ctl:Tile Grid.Column="1" Title="Season series" IsVisible="{Binding !HasFourFactors}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MeetingsTemplate}" />
        </ctl:Tile>
      </Grid>

      <ctl:Tile Title="Season series" IsVisible="{Binding HasFourFactors}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MeetingsTemplate}" />
      </ctl:Tile>

      <!-- Each side's line-up: starters, then the bench, then team totals. -->
      <StackPanel Spacing="{StaticResource Space8}">
        <TextBlock Text="{Binding LineupHeading, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="h3" />
        <TextBlock Text="{Binding LineupNote}" Classes="caption wrap" />
      </StackPanel>
      <ctl:Tile>
        <StackPanel Spacing="{StaticResource Space8}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <ctl:TeamLogo TeamId="{Binding Away.TeamId}" TeamName="{Binding Away.TeamName}" Size="32" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Away.TeamName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="h3" VerticalAlignment="Center" />
          </StackPanel>
          <ctl:DataTable Height="{Binding AwayTableHeight}" Columns="{Binding AwayColumns}" Rows="{Binding AwayRows}" EmptyHeadline="No line-up" EmptyMessage="{Binding Away.LineupNote}" />
          <TextBlock Text="{Binding Away.TeamRebounds}" Classes="caption wrap" IsVisible="{Binding Away.HasTeamRebounds}" />
        </StackPanel>
      </ctl:Tile>
      <ctl:Tile>
        <StackPanel Spacing="{StaticResource Space8}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
            <ctl:TeamLogo TeamId="{Binding Home.TeamId}" TeamName="{Binding Home.TeamName}" Size="32" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Home.TeamName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="h3" VerticalAlignment="Center" />
          </StackPanel>
          <ctl:DataTable Height="{Binding HomeTableHeight}" Columns="{Binding HomeColumns}" Rows="{Binding HomeRows}" EmptyHeadline="No line-up" EmptyMessage="{Binding Home.LineupNote}" />
          <TextBlock Text="{Binding Home.TeamRebounds}" Classes="caption wrap" IsVisible="{Binding Home.HasTeamRebounds}" />
        </StackPanel>
      </ctl:Tile>
    </StackPanel>
  </ScrollViewer>
  </Panel>
</UserControl>
