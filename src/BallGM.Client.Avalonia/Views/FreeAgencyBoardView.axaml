<UserControl
  x:Class="BallGM.Client.Avalonia.Views.FreeAgencyBoardView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  x:DataType="vm:FreeAgencyBoardViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBlock Text="{Binding BoardLine}" Classes="dim small" TextWrapping="Wrap" VerticalAlignment="Center" />
      <TextBlock Classes="eyebrow" Grid.Column="1" Text="Day" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="2" Value="{Binding Day}" Minimum="0" Maximum="365" Increment="1" FormatString="0" Width="110" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,24,340">
      <DockPanel>
        <!-- Depth strip: our roster at each position. Picking one narrows the table to it, so the
             market is always read against our own gap, never as a league-wide best-available list. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,12">
          <ToggleButton Classes="chip" Content="All" IsChecked="{Binding IsShowingAllPositions, Mode=OneWay}" Command="{Binding ShowAllPositionsCommand}" VerticalAlignment="Stretch" />
          <ListBox Grid.Column="1" Classes="strip" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BoardColumnRow">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding DepthLine}">
                  <TextBlock Text="{Binding Position}" Classes="h2" />
                  <Border Grid.Column="1" Classes="ovr small" IsVisible="{Binding HasOwnPlayers}" Background="{Binding BestOwnOverall, Converter={x:Static conv:OverallTierConverter.Instance}}">
                    <TextBlock Text="{Binding BestOwnOverall}" />
                  </Border>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DepthLine}" Classes="small dim" Classes.warn="{Binding IsThin}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding RowCountLine}" Classes="faint small" Margin="10,0,0,6" />

        <Grid DockPanel.Dock="Top" Classes="thead" ColumnDefinitions="34,36,*,52,46,46,80,140,120,20">
          <Button Classes="th" Content="OVR" Command="{Binding SortCommand}" CommandParameter="overall" />
          <Button Grid.Column="2" Classes="th" Content="Player" Command="{Binding SortCommand}" CommandParameter="name" />
          <Button Grid.Column="3" Classes="th" Content="POS" Command="{Binding SortCommand}" CommandParameter="position" />
          <Button Grid.Column="4" Classes="th" Content="Age" Command="{Binding SortCommand}" CommandParameter="age" />
          <Button Grid.Column="5" Classes="th" Content="Svc" Command="{Binding SortCommand}" CommandParameter="service" ToolTip.Tip="Seasons of service" />
          <Button Grid.Column="6" Classes="th" Content="Asking" Command="{Binding SortCommand}" CommandParameter="asking" />
          <TextBlock Grid.Column="7" Text="Market" />
          <TextBlock Grid.Column="8" Text="Our offer" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Nobody unsigned at this position." Classes="dim" Margin="10,8" IsVisible="{Binding !Rows.Count}" />

        <ListBox Classes="table" ItemsSource="{Binding Rows}" SelectedItem="{Binding Candidate}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BoardCandidateRow">
              <Grid ColumnDefinitions="34,36,*,52,46,46,80,140,120,20" Height="28">
                <Border Classes="ovr" Background="{Binding Overall, Converter={x:Static conv:OverallTierConverter.Instance}}">
                  <TextBlock Text="{Binding Overall}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding FullName}" Classes="strong" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="3" Classes="pill">
                  <TextBlock Text="{Binding Position}" />
                </Border>
                <TextBlock Grid.Column="4" Text="{Binding Age}" Classes="num" />
                <TextBlock Grid.Column="5" Text="{Binding SeasonsOfService}" Classes="num dim" />
                <TextBlock Grid.Column="6" Text="{Binding AskCell}" Classes="num" />
                <TextBlock Grid.Column="7" Text="{Binding MarketCell}" Classes="dim small" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="8" Text="{Binding OurOfferCell}" Classes="num" Classes.dim="{Binding !HasOurOffer}" />
                <Ellipse Grid.Column="9" Width="8" Height="8" Fill="{StaticResource WarnBrush}" IsVisible="{Binding HasCounter}" ToolTip.Tip="{Binding CounterLine}" HorizontalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBlock Classes="section" Text="Selected" />
          <TextBlock Text="{Binding CandidateLine}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />

          <TextBlock Classes="eyebrow" Text="First season ($M)" Margin="0,8,0,0" />
          <TextBox Text="{Binding FirstSeasonSalary}" />

          <TextBlock Classes="eyebrow" Text="Seasons" />
          <NumericUpDown Value="{Binding Seasons}" Minimum="1" Maximum="12" Increment="1" FormatString="0" />

          <Grid ColumnDefinitions="*,8,*" Margin="0,6,0,0">
            <Button Classes="primary" Content="Offer" Command="{Binding OfferCommand}" IsEnabled="{Binding HasCandidate}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Counter" Command="{Binding CounterCommand}" IsEnabled="{Binding HasCandidate}" HorizontalAlignment="Stretch" />
          </Grid>

          <Grid ColumnDefinitions="*,8,*">
            <Button Content="Check market" Command="{Binding CheckMarketCommand}" IsEnabled="{Binding HasCandidate}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Resolve market" Command="{Binding ResolveMarketCommand}" IsEnabled="{Binding HasCandidate}" HorizontalAlignment="Stretch" />
          </Grid>

          <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock Text="{Binding MarketLine}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Margin="0,10,0,0">
          <StackPanel Spacing="8">
            <ItemsControl ItemsSource="{Binding Standings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MarketStandingRow">
                  <Border Classes="panel" Padding="6" Margin="0,0,0,6">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding TeamName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding RankLabel}" FontSize="11" Opacity="0.7" />
                      </Grid>
                      <TextBlock Text="{Binding Terms}" FontSize="11" Opacity="0.7" />
                      <TextBlock Text="{Binding Narrative}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />

                      <ItemsControl ItemsSource="{Binding Factors}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PreferenceFactorRow">
                            <StackPanel Margin="0,1">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Factor}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding ScoreLine}" FontSize="10" Opacity="0.6" />
                              </Grid>
                              <TextBlock Text="{Binding Explanation}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <ItemsControl ItemsSource="{Binding Exclusions}" IsVisible="{Binding HasExclusions}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SigningFindingRow">
                            <TextBlock Text="{Binding Explanation}" FontSize="10" Opacity="0.75" TextWrapping="Wrap" Margin="0,1" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding HasWarnings}" Spacing="2">
              <TextBlock Classes="section" Text="Worth knowing" />
              <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SigningFindingRow">
                    <TextBlock Text="{Binding Explanation}" FontSize="10" Opacity="0.7" TextWrapping="Wrap" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasNotes}" Spacing="2">
              <TextBlock Classes="section" Text="Not rules in this league" />
              <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SigningFindingRow">
                    <TextBlock Text="{Binding Explanation}" FontSize="10" Opacity="0.7" TextWrapping="Wrap" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasOurNegotiations}" Spacing="2">
              <TextBlock Classes="section" Text="Our markets" />
              <ItemsControl ItemsSource="{Binding OurNegotiations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BoardNegotiationRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <StackPanel>
                        <TextBlock Text="{Binding PlayerName}" FontSize="11" />
                        <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.6" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="10" Opacity="0.6" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
