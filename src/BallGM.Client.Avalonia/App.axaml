<Application
  x:Class="BallGM.Client.Avalonia.App"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent supplies control templates; its dark palette is retuned to the design tokens so
         stock controls (combo boxes, focus rings, scroll bars) match the custom surfaces. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources
          x:Key="Dark"
          Accent="#E06A2C"
          AltHigh="#0D1522"
          AltLow="#0D1522"
          AltMedium="#0D1522"
          AltMediumHigh="#0D1522"
          AltMediumLow="#0D1522"
          BaseHigh="#EAEEF4"
          BaseLow="#22314A"
          BaseMedium="#A3AEC2"
          BaseMediumHigh="#C3CAD6"
          BaseMediumLow="#7A869C"
          ChromeAltLow="#C3CAD6"
          ChromeBlackHigh="#000000"
          ChromeBlackLow="#C3CAD6"
          ChromeBlackMedium="#000000"
          ChromeBlackMediumLow="#000000"
          ChromeDisabledHigh="#22314A"
          ChromeDisabledLow="#7A869C"
          ChromeGray="#8592AA"
          ChromeHigh="#8592AA"
          ChromeLow="#121C2C"
          ChromeMedium="#172338"
          ChromeMediumLow="#1F2D45"
          ChromeWhite="#FFFFFF"
          ListLow="#172338"
          ListMedium="#22314A"
          RegionColor="#0D1522" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://BallGM.Client.Avalonia/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
