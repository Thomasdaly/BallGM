<Application
  x:Class="BallGM.Client.Avalonia.App"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Typography.axaml" />
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Geometry.axaml" />
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Motion.axaml" />
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Controls/Index.axaml" />
        <ResourceInclude Source="avares://BallGM.Client.Avalonia/Themes/Components/Index.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent supplies control templates; its dark palette is set to the design tokens (docs/ui/spec/01 section 3) so
         stock controls (combo boxes, focus rings, scroll bars) match the custom surfaces. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources
          x:Key="Dark"
          Accent="{StaticResource AccentFallbackColor}"
          AltHigh="{StaticResource CanvasRaisedColor}"
          AltLow="{StaticResource CanvasRaisedColor}"
          AltMedium="{StaticResource CanvasRaisedColor}"
          AltMediumHigh="{StaticResource CanvasRaisedColor}"
          AltMediumLow="{StaticResource CanvasRaisedColor}"
          BaseHigh="{StaticResource TextPrimaryColor}"
          BaseLow="{StaticResource StrokeColor}"
          BaseMedium="{StaticResource TextSecondaryColor}"
          BaseMediumHigh="{StaticResource TextPrimaryColor}"
          BaseMediumLow="{StaticResource TextMutedColor}"
          ChromeAltLow="{StaticResource TextPrimaryColor}"
          ChromeBlackLow="{StaticResource TextPrimaryColor}"
          ChromeDisabledHigh="{StaticResource StrokeColor}"
          ChromeDisabledLow="{StaticResource TextDisabledColor}"
          ChromeGray="{StaticResource TextMutedColor}"
          ChromeHigh="{StaticResource TextMutedColor}"
          ChromeLow="{StaticResource Surface1Color}"
          ChromeMedium="{StaticResource Surface2Color}"
          ChromeMediumLow="{StaticResource Surface3Color}"
          ListLow="{StaticResource Surface2Color}"
          ListMedium="{StaticResource Surface3Color}"
          RegionColor="{StaticResource CanvasRaisedColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Legacy class styles of the screens not yet rebuilt; removed once none uses them. -->
    <StyleInclude Source="avares://BallGM.Client.Avalonia/Themes/Controls.axaml" />
    <StyleInclude Source="avares://BallGM.Client.Avalonia/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
