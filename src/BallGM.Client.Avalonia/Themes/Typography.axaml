<!--
  Typography tokens (docs/ui/spec/01_DESIGN_LANGUAGE.md section 5). Display: Barlow Condensed; body:
  Barlow (the spec's listed OFL alternate to Inter, already embedded - AUDIT.md Decisions). Both SIL
  OFL, embedded and registered by BallGmFontCollection. Text style classes live in Styles.axaml.
-->
<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="BodyFont">fonts:BallGMBody#Barlow</FontFamily>
  <FontFamily x:Key="DisplayFont">fonts:BallGMDisplay#Barlow Condensed</FontFamily>

  <x:Double x:Key="FontSizeHero">56</x:Double>
  <x:Double x:Key="FontSizeHeroSmall">44</x:Double>
  <x:Double x:Key="FontSizeH1">32</x:Double>
  <x:Double x:Key="FontSizeH2">24</x:Double>
  <x:Double x:Key="FontSizeH3">20</x:Double>
  <x:Double x:Key="FontSizeStatXL">56</x:Double>
  <x:Double x:Key="FontSizeStatL">40</x:Double>
  <x:Double x:Key="FontSizeStatM">28</x:Double>
  <x:Double x:Key="FontSizeLabel">11</x:Double>
  <x:Double x:Key="FontSizeLabelLarge">12</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeTable">13</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>

  <x:Double x:Key="LineHeightHero">56</x:Double>
  <x:Double x:Key="LineHeightBody">20</x:Double>
  <x:Double x:Key="LineHeightCaption">16</x:Double>

  <!-- Tracking: LetterSpacing in DIPs at each role's size (+1%, +2%, +3%, +8% of the em). -->
  <x:Double x:Key="TrackingHero">0.56</x:Double>
  <x:Double x:Key="TrackingH1">0.64</x:Double>
  <x:Double x:Key="TrackingH2">0.48</x:Double>
  <x:Double x:Key="TrackingH3">0.6</x:Double>
  <x:Double x:Key="TrackingLabel">0.9</x:Double>

  <FontFeatureCollection x:Key="TabularFigures">+tnum</FontFeatureCollection>
</ResourceDictionary>
