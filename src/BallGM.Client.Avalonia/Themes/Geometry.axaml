<!--
  Geometry tokens (docs/ui/spec/01_DESIGN_LANGUAGE.md sections 6-7): the 4px spacing scale, radii,
  the 12-degree signature angle, the cut-corner size, density row heights and shell dimensions.
  Nothing off-scale: views take spacing from here.
-->
<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Spacing scale: 4, 8, 12, 16, 24, 32, 48, 64. -->
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="Space32">32</x:Double>
  <x:Double x:Key="Space48">48</x:Double>
  <x:Double x:Key="Space64">64</x:Double>
  <Thickness x:Key="Pad4">4</Thickness>
  <Thickness x:Key="Pad8">8</Thickness>
  <Thickness x:Key="Pad12">12</Thickness>
  <Thickness x:Key="Pad16">16</Thickness>
  <Thickness x:Key="Pad24">24</Thickness>
  <Thickness x:Key="Pad32">32</Thickness>
  <Thickness x:Key="PadH8">8,0</Thickness>
  <Thickness x:Key="PadH12">12,0</Thickness>
  <Thickness x:Key="PadH16">16,0</Thickness>
  <Thickness x:Key="PadH24">24,0</Thickness>
  <Thickness x:Key="PadV4">0,4</Thickness>
  <Thickness x:Key="PadV8">0,8</Thickness>
  <Thickness x:Key="PadV12">0,12</Thickness>
  <Thickness x:Key="PadV16">0,16</Thickness>
  <Thickness x:Key="Pad8x4">8,4</Thickness>
  <Thickness x:Key="Pad12x4">12,4</Thickness>
  <Thickness x:Key="Pad12x8">12,8</Thickness>
  <Thickness x:Key="Pad16x8">16,8</Thickness>
  <Thickness x:Key="Pad16x12">16,12</Thickness>
  <Thickness x:Key="Pad24x12">24,12</Thickness>
  <Thickness x:Key="Pad24x16">24,16</Thickness>
  <Thickness x:Key="GapBottom4">0,0,0,4</Thickness>
  <Thickness x:Key="GapBottom8">0,0,0,8</Thickness>
  <Thickness x:Key="GapBottom12">0,0,0,12</Thickness>
  <Thickness x:Key="GapBottom16">0,0,0,16</Thickness>
  <Thickness x:Key="GapBottom24">0,0,0,24</Thickness>
  <Thickness x:Key="GapTop8">0,8,0,0</Thickness>
  <Thickness x:Key="GapTop16">0,16,0,0</Thickness>
  <Thickness x:Key="GapRight8">0,0,8,0</Thickness>
  <Thickness x:Key="GapRight16">0,0,16,0</Thickness>
  <Thickness x:Key="GapLeft8">8,0,0,0</Thickness>
  <Thickness x:Key="GapLeft16">16,0,0,0</Thickness>
  <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
  <Thickness x:Key="PagePaddingCompact">16,12,16,16</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="CardPaddingCompact">12</Thickness>
  <Thickness x:Key="HairlineBottom">0,0,0,1</Thickness>
  <Thickness x:Key="HairlineTop">0,1,0,0</Thickness>
  <Thickness x:Key="HairlineRight">0,0,1,0</Thickness>
  <Thickness x:Key="Hairline">1</Thickness>
  <Thickness x:Key="AccentStripeLeft">3,0,0,0</Thickness>
  <Thickness x:Key="FocusRingThickness">2</Thickness>

  <!-- Radii: 0 for structure, 2 for chips and inputs, 4 maximum for cards. -->
  <CornerRadius x:Key="RadiusNone">0</CornerRadius>
  <CornerRadius x:Key="RadiusChip">2</CornerRadius>
  <CornerRadius x:Key="RadiusCard">4</CornerRadius>
  <CornerRadius x:Key="RadiusRound">999</CornerRadius>

  <!-- Signature shapes. -->
  <x:Double x:Key="SkewAngle">12</x:Double>
  <x:Double x:Key="CutSize">16</x:Double>
  <x:Double x:Key="AccentStripeWidth">3</x:Double>

  <!-- Density (spec 01 section 7): rows 40 / 28, list items 56 / 44. DensityService swaps these. -->
  <x:Double x:Key="RowHeight">40</x:Double>
  <x:Double x:Key="ListItemHeight">56</x:Double>
  <x:Double x:Key="RowHeightComfortable">40</x:Double>
  <x:Double x:Key="RowHeightCompact">28</x:Double>
  <x:Double x:Key="ListItemHeightComfortable">56</x:Double>
  <x:Double x:Key="ListItemHeightCompact">44</x:Double>

  <!-- Shell. -->
  <x:Double x:Key="HeaderBandHeight">64</x:Double>
  <x:Double x:Key="NavRailExpandedWidth">220</x:Double>
  <x:Double x:Key="NavRailCollapsedWidth">64</x:Double>
  <x:Double x:Key="TickerHeight">32</x:Double>
  <x:Double x:Key="ReadingMaxWidth">760</x:Double>
  <x:Double x:Key="TargetMin">24</x:Double>

  <!-- Icon and image slots (DIPs). -->
  <x:Double x:Key="IconSmall">16</x:Double>
  <x:Double x:Key="IconMedium">20</x:Double>
  <x:Double x:Key="IconLarge">24</x:Double>
  <x:Double x:Key="HeadshotXS">24</x:Double>
  <x:Double x:Key="HeadshotS">32</x:Double>
  <x:Double x:Key="HeadshotM">48</x:Double>
  <x:Double x:Key="HeadshotL">96</x:Double>
  <x:Double x:Key="HeadshotXL">160</x:Double>
  <x:Double x:Key="HeadshotHero">320</x:Double>

  <!-- A table's name column never narrows below this; wider tables scroll inside their own frame. -->
  <x:Double x:Key="TableNameMinWidth">160</x:Double>

  <!-- Court lines, drawn as vector paths: a half court, for motifs at 5% or less. -->
  <StreamGeometry x:Key="Court.HalfCourt">M0 0H520M260 0V40M300 0A40 40 0 0 1 220 0M150 0V150H370V0M150 150H370M200 150A60 60 0 0 0 320 150M30 0V60A230 230 0 0 0 490 60V0</StreamGeometry>
  <!-- A head-and-shoulders silhouette on a 100 x 100 grid (the player fallback, spec 05 section 6). -->
  <StreamGeometry x:Key="Silhouette.Player">M50 14C61 14 69 23 69 35C69 47 61 57 50 57C39 57 31 47 31 35C31 23 39 14 50 14ZM14 100C14 78 29 64 50 64C71 64 86 78 86 100Z</StreamGeometry>

  <!-- Legacy keys from the pre-overhaul theme; removed once no view uses them. -->
  <CornerRadius x:Key="RadiusSmall">2</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">4</CornerRadius>
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>
  <Thickness x:Key="StatCellPadding">0,0,8,0</Thickness>
  <Thickness x:Key="StatBlockGutter">0,0,16,0</Thickness>
</ResourceDictionary>
