<!--
  Colour tokens (docs/ui/spec/01_DESIGN_LANGUAGE.md section 3). Every colour the client draws with
  lives here; views use these brushes or a style class, never a literal.

  Static tokens are referenced with StaticResource. The team keys (Accent*, TeamPrimaryRaw*,
  TeamSecondaryRaw*, OnPrimaryRaw*, TeamGradient*) and the active tier palette (Tier*Brush,
  Tier*OnBrush) are replaced at runtime by TeamThemeService and RatingPaletteService, so they are
  always referenced with DynamicResource. A page about another team sets the same keys on its own
  root to scope its colours (spec 02 section 3).
-->
<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces, darkest to lightest. Elevation is a step up this ladder, not a border. -->
  <Color x:Key="CanvasColor">#0A0E14</Color>
  <Color x:Key="CanvasRaisedColor">#0F1520</Color>
  <Color x:Key="Surface1Color">#141B27</Color>
  <Color x:Key="Surface2Color">#1A2331</Color>
  <Color x:Key="Surface3Color">#222D3E</Color>
  <Color x:Key="StrokeColor">#2A3547</Color>

  <!-- Text. Muted still clears 4.5:1 on every surface; Disabled is for disabled controls only. -->
  <Color x:Key="TextPrimaryColor">#F2F5F9</Color>
  <Color x:Key="TextSecondaryColor">#A9B4C4</Color>
  <Color x:Key="TextMutedColor">#8C99AD</Color>
  <Color x:Key="TextDisabledColor">#5B6779</Color>

  <!-- Semantic. Text, icons and chips only - never large backgrounds. -->
  <Color x:Key="AccentFallbackColor">#3D8BFF</Color>
  <Color x:Key="PositiveColor">#2BD67B</Color>
  <Color x:Key="NegativeColor">#FF6B78</Color>
  <Color x:Key="WarningColor">#FFA53D</Color>
  <Color x:Key="InfoColor">#4CC2FF</Color>
  <Color x:Key="PositiveCvdColor">#5AAEFF</Color>
  <Color x:Key="NegativeCvdColor">#FF9F43</Color>
  <Color x:Key="FocusRingColor">#F2F5F9</Color>
  <Color x:Key="ScrimColor">#B80A0E14</Color>
  <Color x:Key="ShadowColor">#59000000</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="CanvasRaisedBrush" Color="{StaticResource CanvasRaisedColor}" />
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
  <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
  <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeColor}" Opacity="0.5" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
  <SolidColorBrush x:Key="AccentFallbackBrush" Color="{StaticResource AccentFallbackColor}" />
  <SolidColorBrush x:Key="PositiveTextBrush" Color="{StaticResource PositiveColor}" />
  <SolidColorBrush x:Key="NegativeTextBrush" Color="{StaticResource NegativeColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
  <SolidColorBrush x:Key="PureWhiteBrush" Color="#FFFFFF" />
  <!-- Hover and press on coloured plates (accent, team bands): a light or dark veil, not a new colour. -->
  <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="PressedOverlayBrush" Color="#29000000" />
  <SolidColorBrush x:Key="PureBlackBrush" Color="#000000" />
  <!-- Soft fills behind semantic chips: the colour at 16% over the surface. -->
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningColor}" Opacity="0.16" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoColor}" Opacity="0.16" />

  <!-- Positive / negative follow the colour-vision setting: RatingPaletteService swaps these. -->
  <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
  <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />
  <SolidColorBrush x:Key="PositiveSoftBrush" Color="{StaticResource PositiveColor}" Opacity="0.16" />
  <SolidColorBrush x:Key="NegativeSoftBrush" Color="{StaticResource NegativeColor}" Opacity="0.16" />

  <!-- Team: replaced by TeamThemeService (spec 01 section 4). Defaults are the fallback accent. -->
  <Color x:Key="AccentColor">#3D8BFF</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#5C9DFF" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F72D6" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#333D8BFF" />
  <SolidColorBrush x:Key="AccentFaintBrush" Color="#143D8BFF" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />
  <SolidColorBrush x:Key="AccentAltBrush" Color="#5C9DFF" />
  <SolidColorBrush x:Key="TeamPrimaryRawBrush" Color="#1A2331" />
  <SolidColorBrush x:Key="TeamSecondaryRawBrush" Color="#3D8BFF" />
  <SolidColorBrush x:Key="OnPrimaryRawBrush" Color="#FFFFFF" />
  <LinearGradientBrush x:Key="TeamGradientBrush" StartPoint="0%,30%" EndPoint="100%,70%">
    <GradientStop Offset="0" Color="#1A2331" />
    <GradientStop Offset="1" Color="#001A2331" />
  </LinearGradientBrush>

  <!-- Rating tiers (spec 01 section 12): default (loot ladder) and colour-vision-safe (cividis). -->
  <Color x:Key="TierEliteDefaultColor">#F5C542</Color>
  <Color x:Key="TierStarDefaultColor">#A77BFF</Color>
  <Color x:Key="TierStarterDefaultColor">#58A6FF</Color>
  <Color x:Key="TierRotationDefaultColor">#2EC27E</Color>
  <Color x:Key="TierBenchDefaultColor">#C5CDD8</Color>
  <Color x:Key="TierFringeDefaultColor">#6B7686</Color>
  <Color x:Key="TierEliteCvdColor">#FEE838</Color>
  <Color x:Key="TierStarCvdColor">#DAC65B</Color>
  <Color x:Key="TierStarterCvdColor">#B4A76F</Color>
  <Color x:Key="TierRotationCvdColor">#908B78</Color>
  <Color x:Key="TierBenchCvdColor">#6F7073</Color>
  <Color x:Key="TierFringeCvdColor">#4F576C</Color>
  <SolidColorBrush x:Key="TierEliteBrush" Color="{StaticResource TierEliteDefaultColor}" />
  <SolidColorBrush x:Key="TierStarBrush" Color="{StaticResource TierStarDefaultColor}" />
  <SolidColorBrush x:Key="TierStarterBrush" Color="{StaticResource TierStarterDefaultColor}" />
  <SolidColorBrush x:Key="TierRotationBrush" Color="{StaticResource TierRotationDefaultColor}" />
  <SolidColorBrush x:Key="TierBenchBrush" Color="{StaticResource TierBenchDefaultColor}" />
  <SolidColorBrush x:Key="TierFringeBrush" Color="{StaticResource TierFringeDefaultColor}" />
  <SolidColorBrush x:Key="TierEliteOnBrush" Color="#000000" />
  <SolidColorBrush x:Key="TierStarOnBrush" Color="#000000" />
  <SolidColorBrush x:Key="TierStarterOnBrush" Color="#000000" />
  <SolidColorBrush x:Key="TierRotationOnBrush" Color="#000000" />
  <SolidColorBrush x:Key="TierBenchOnBrush" Color="#000000" />
  <SolidColorBrush x:Key="TierFringeOnBrush" Color="#FFFFFF" />

  <!-- Canvas: a quiet top-to-bottom fall from Canvas to CanvasRaised (spec 01 section 8). -->
  <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="{StaticResource CanvasColor}" />
    <GradientStop Offset="1" Color="{StaticResource CanvasRaisedColor}" />
  </LinearGradientBrush>

  <!-- Charts: data, never status or team colour. Gridlines are Stroke at 50%. -->
  <Color x:Key="ChartCold3Color">#33508F</Color>
  <Color x:Key="ChartCold2Color">#4566BC</Color>
  <Color x:Key="ChartCold1Color">#5878DA</Color>
  <Color x:Key="ChartNeutralColor">#3E4A60</Color>
  <Color x:Key="ChartHot1Color">#8E3D2C</Color>
  <Color x:Key="ChartHot2Color">#C5543A</Color>
  <Color x:Key="ChartHot3Color">#F08A68</Color>
  <SolidColorBrush x:Key="ChartCold3Brush" Color="{StaticResource ChartCold3Color}" />
  <SolidColorBrush x:Key="ChartCold2Brush" Color="{StaticResource ChartCold2Color}" />
  <SolidColorBrush x:Key="ChartCold1Brush" Color="{StaticResource ChartCold1Color}" />
  <SolidColorBrush x:Key="ChartNeutralBrush" Color="{StaticResource ChartNeutralColor}" />
  <SolidColorBrush x:Key="ChartHot1Brush" Color="{StaticResource ChartHot1Color}" />
  <SolidColorBrush x:Key="ChartHot2Brush" Color="{StaticResource ChartHot2Color}" />
  <SolidColorBrush x:Key="ChartHot3Brush" Color="{StaticResource ChartHot3Color}" />
  <SolidColorBrush x:Key="ChartSequentialBrush" Color="{StaticResource ChartCold1Color}" />
  <SolidColorBrush x:Key="ChartPlateBrush" Color="{StaticResource CanvasRaisedColor}" Opacity="0.85" />
  <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource StrokeColor}" Opacity="0.5" />

  <!--
    Legacy keys from the pre-overhaul theme, kept as aliases of the spec tokens so screens not yet
    rebuilt keep compiling and already sit on the new palette. Removed once no view uses them.
  -->
  <Color x:Key="Bg0Color">#0F1520</Color>
  <Color x:Key="Bg1Color">#141B27</Color>
  <Color x:Key="Bg2Color">#1A2331</Color>
  <Color x:Key="Bg3Color">#222D3E</Color>
  <Color x:Key="Bg4Color">#2A3547</Color>
  <Color x:Key="LineColor">#2A3547</Color>
  <Color x:Key="TextColor">#F2F5F9</Color>
  <Color x:Key="TextDimColor">#A9B4C4</Color>
  <Color x:Key="TextFaintColor">#8C99AD</Color>
  <Color x:Key="OnAccentColor">#000000</Color>
  <Color x:Key="MapleColor">#8C99AD</Color>
  <Color x:Key="GoodColor">#2BD67B</Color>
  <Color x:Key="WarnColor">#FFA53D</Color>
  <Color x:Key="BadColor">#FF6B78</Color>
  <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}" />
  <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}" />
  <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3Color}" />
  <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4Color}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
  <SolidColorBrush x:Key="MapleBrush" Color="{StaticResource MapleColor}" />
  <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
  <SolidColorBrush x:Key="GoodSoftBrush" Color="{StaticResource GoodColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="BadPillBrush" Color="{StaticResource BadColor}" Opacity="0.2" />
  <SolidColorBrush x:Key="GoodPillBrush" Color="{StaticResource GoodColor}" Opacity="0.2" />
  <LinearGradientBrush x:Key="BannerBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#141B27" />
    <GradientStop Offset="0.55" Color="#141B27" />
    <GradientStop Offset="1" Color="#1A2331" />
  </LinearGradientBrush>
</ResourceDictionary>
