<!--
  Design tokens: every colour, typeface, size, and icon the client draws with, in one place. Views
  never hard-code a colour; they use a style class from Controls.axaml or one of these brushes.

  Direction, "the scorer's table": a management-sim layout (persistent grouped nav, team identity
  band, dense tables) set on arena-navy surfaces rather than neutral black. The one accent is the
  team's own colour - "paint", like the painted lane - which TeamPaint derives from the pack's logo
  at runtime and writes into the Accent* brushes below; the values here are only the fallback for a
  league without logos. Type is Barlow (body) and Barlow Condensed (headings and every number), a
  jersey-and-scoreboard voice. All original: no league or publisher marks.
-->
<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typefaces, embedded (SIL OFL, licence beside the files) and registered by BallGmFontCollection. -->
  <FontFamily x:Key="BodyFont">fonts:BallGM#Barlow</FontFamily>
  <FontFamily x:Key="DisplayFont">fonts:BallGM#Barlow Condensed</FontFamily>

  <!-- Surfaces, darkest to lightest: arena navy. -->
  <Color x:Key="Bg0Color">#0D1522</Color>
  <Color x:Key="Bg1Color">#121C2C</Color>
  <Color x:Key="Bg2Color">#172338</Color>
  <Color x:Key="Bg3Color">#1F2D45</Color>
  <Color x:Key="Bg4Color">#2A3B58</Color>
  <Color x:Key="LineColor">#22314A</Color>

  <!-- Text. Faint still clears 4.5:1 on Bg0 through Bg2. -->
  <Color x:Key="TextColor">#EAEEF4</Color>
  <Color x:Key="TextDimColor">#A3AEC2</Color>
  <Color x:Key="TextFaintColor">#8592AA</Color>

  <!-- Paint: the team colour. Fallback is ball leather; TeamPaint overwrites these brushes. -->
  <Color x:Key="AccentColor">#E06A2C</Color>
  <Color x:Key="AccentHoverColor">#E8834F</Color>
  <Color x:Key="AccentPressedColor">#C45A22</Color>
  <Color x:Key="AccentSoftColor">#33E06A2C</Color>
  <Color x:Key="AccentFaintColor">#14E06A2C</Color>
  <Color x:Key="OnAccentColor">#0D1522</Color>

  <!-- Hardwood: the court itself. Decorative only (court lines, the wordmark), never an action. -->
  <Color x:Key="MapleColor">#D8A86A</Color>

  <!-- Status: reserved, never reused as a series or tier colour. -->
  <Color x:Key="GoodColor">#45C98C</Color>
  <Color x:Key="WarnColor">#F59E3D</Color>
  <Color x:Key="BadColor">#F2606F</Color>
  <Color x:Key="InfoColor">#6DB6F2</Color>

  <!-- Rating tiers (Overall). Dark numerals sit on each; every tier clears 4.5:1 against them. -->
  <Color x:Key="TierEliteColor">#B996FF</Color>
  <Color x:Key="TierStarColor">#F5CE5A</Color>
  <Color x:Key="TierStarterColor">#6DB6F2</Color>
  <Color x:Key="TierRotationColor">#45C98C</Color>
  <Color x:Key="TierBenchColor">#9AA4B8</Color>
  <Color x:Key="TierFringeColor">#7A869C</Color>

  <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}" />
  <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}" />
  <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3Color}" />
  <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4Color}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
  <!-- Mutable on purpose: TeamPaint sets Color on these instances, so every StaticResource user follows. -->
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentFaintBrush" Color="{StaticResource AccentFaintColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="MapleBrush" Color="{StaticResource MapleColor}" />
  <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="GoodSoftBrush" Color="#1F45C98C" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="#1FF59E3D" />
  <SolidColorBrush x:Key="BadSoftBrush" Color="#1FF2606F" />
  <SolidColorBrush x:Key="BadPillBrush" Color="#33F2606F" />
  <SolidColorBrush x:Key="TierEliteBrush" Color="{StaticResource TierEliteColor}" />
  <SolidColorBrush x:Key="TierStarBrush" Color="{StaticResource TierStarColor}" />
  <SolidColorBrush x:Key="TierStarterBrush" Color="{StaticResource TierStarterColor}" />
  <SolidColorBrush x:Key="TierRotationBrush" Color="{StaticResource TierRotationColor}" />
  <SolidColorBrush x:Key="TierBenchBrush" Color="{StaticResource TierBenchColor}" />
  <SolidColorBrush x:Key="TierFringeBrush" Color="{StaticResource TierFringeColor}" />

  <!-- The identity band: navy that takes on the team's paint toward the far edge. TeamPaint
       rewrites the last two stops, so they must stay mutable GradientStops at these indexes. -->
  <LinearGradientBrush x:Key="BannerBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#121C2C" />
    <GradientStop Offset="0.55" Color="#2A1A14" />
    <GradientStop Offset="1" Color="#5A2A12" />
  </LinearGradientBrush>

  <!-- Court lines drawn across the identity band: half-court circle, lane, and arc. Stroked faint. -->
  <StreamGeometry x:Key="Court.HalfCourt">M0 0H520M260 0V40M300 0A40 40 0 0 1 220 0M150 0V150H370V0M150 150H370M200 150A60 60 0 0 0 320 150M30 0V60A230 230 0 0 0 490 60V0</StreamGeometry>

  <!-- Sizes. -->
  <CornerRadius x:Key="RadiusSmall">3</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
  <x:Double x:Key="RowHeight">34</x:Double>

  <!-- Navigation icons: 24x24, stroked-look filled paths, drawn for this project. -->
  <StreamGeometry x:Key="Icon.Roster">M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM1 20c0-3.9 3.6-7 8-7s8 3.1 8 7v1H1v-1Zm17.5-6.8c2.6.6 4.5 2.8 4.5 5.3V20h-4v-1c0-2.3-.9-4.3-2.4-5.8.6 0 1.2 0 1.9 0Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.CapSheet">M12 1a11 11 0 1 0 0 22 11 11 0 0 0 0-22Zm1 17.9V20h-2v-1.1c-1.9-.3-3.3-1.5-3.5-3.3h2.1c.2.9 1 1.5 2.4 1.5 1.5 0 2.2-.6 2.2-1.4 0-.9-.7-1.3-2.6-1.8-2.4-.6-3.8-1.4-3.8-3.4 0-1.6 1.3-2.8 3.2-3.1V6h2v1.4c1.8.4 2.9 1.6 3.1 3.2h-2.1c-.2-.8-.9-1.3-2.1-1.3-1.3 0-1.9.6-1.9 1.3 0 .8.7 1.1 2.6 1.6 2.4.6 3.8 1.5 3.8 3.6 0 1.7-1.3 2.8-3.4 3.1Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.PickBoard">M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a3 3 0 0 0 0 6v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a3 3 0 0 0 0-6V5Zm6 2v2h2V7H9Zm0 4v2h2v-2H9Zm0 4v2h2v-2H9Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Trade">M16 3l5 5-5 5V9.5H4v-3h12V3ZM8 11v3.5h12v3H8V21l-5-5 5-5Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.FreeAgency">M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm8 1.5V8h4.5L14 3.5ZM7 12v2h10v-2H7Zm0 4v2h6v-2H7Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.FreeAgencyBoard">M3 3h8v8H3V3Zm10 0h8v8h-8V3ZM3 13h8v8H3v-8Zm10 0h8v8h-8v-8Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Calendar">M7 1h2v2h6V1h2v2h2a2 2 0 0 1 2 2v15a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h2V1ZM5 9v11h14V9H5Zm2 2h4v4H7v-4Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.FrontOffice">M9 2h6a2 2 0 0 1 2 2v2h4a2 2 0 0 1 2 2v4H1V8a2 2 0 0 1 2-2h4V4a2 2 0 0 1 2-2Zm0 2v2h6V4H9ZM1 14h9v2h4v-2h9v6a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-6Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Contracts">M5 2h10l4 4v5.5a6.5 6.5 0 0 0-8.9 10.5H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1 6v2h8V8H6Zm0 4v2h5v-2H6Zm11 1a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm-.9 2.2v3.3l2.8 1.7.8-1.3-2.1-1.3v-2.4h-1.5Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Default">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z</StreamGeometry>
  <!-- The wordmark's ball: outline and seams, stroked. -->
  <StreamGeometry x:Key="Icon.BallSeams">M12 1V23M1 12H23M4.5 4.2A11 11 0 0 1 4.5 19.8M19.5 4.2A11 11 0 0 0 19.5 19.8</StreamGeometry>
</ResourceDictionary>
