<!--
  Class styles, declared last (docs/ui/spec/02_AVALONIA_GUIDE.md section 2): the text roles of spec 01
  section 5, density, and the reduced-motion overrides. Views say Classes="h1" or "label-caps"; they
  never set a font size, family or colour themselves (the token lint enforces it).

  Text roles: hero, h1, h2, h3, stat-xl, stat-l, stat-m, label-caps, body, body-strong, table, caption,
  plus modifiers: num (tabular figures, right-aligned by the caller), secondary, muted, accent,
  positive, negative, warning, italic (hero and score contexts only).
-->
<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <Style Selector="TextBlock.hero">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightHero}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TrackingHero}" />
  </Style>
  <Style Selector="TextBlock.hero.small">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeroSmall}" />
    <Setter Property="LineHeight" Value="{StaticResource FontSizeHeroSmall}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeH1}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TrackingH1}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeH2}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TrackingH2}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeH3}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TrackingH3}" />
  </Style>
  <Style Selector="TextBlock.stat-xl">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeStatXL}" />
    <Setter Property="LineHeight" Value="{StaticResource FontSizeStatXL}" />
    <Setter Property="FontFeatures" Value="{StaticResource TabularFigures}" />
  </Style>
  <Style Selector="TextBlock.stat-l">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeStatL}" />
    <Setter Property="FontFeatures" Value="{StaticResource TabularFigures}" />
  </Style>
  <Style Selector="TextBlock.stat-m">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeStatM}" />
    <Setter Property="FontFeatures" Value="{StaticResource TabularFigures}" />
  </Style>
  <Style Selector="TextBlock.label-caps">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TrackingLabel}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.label-caps.large">
    <Setter Property="FontSize" Value="{StaticResource FontSizeLabelLarge}" />
  </Style>
  <!-- The same roles without a colour, for template text that sets its own (a class outranks a value set in a template). -->
  <Style Selector="TextBlock.caps">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TrackingLabel}" />
  </Style>
  <Style Selector="TextBlock.caps.large">
    <Setter Property="FontSize" Value="{StaticResource FontSizeLabelLarge}" />
  </Style>
  <Style Selector="TextBlock.caption-plain">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
  </Style>
  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.table">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTable}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="{StaticResource TabularFigures}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <!-- Modifiers. -->
  <Style Selector="TextBlock.num">
    <Setter Property="FontFeatures" Value="{StaticResource TabularFigures}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.positive">
    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
  </Style>
  <Style Selector="TextBlock.negative">
    <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.on-accent">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.on-primary">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryRawBrush}" />
  </Style>
  <Style Selector="TextBlock.italic">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="TextBlock.wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.trim">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Icons: PathIcon sizes 16 / 20 / 24. -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="{StaticResource IconMedium}" />
    <Setter Property="Height" Value="{StaticResource IconMedium}" />
  </Style>
  <Style Selector="PathIcon.small">
    <Setter Property="Width" Value="{StaticResource IconSmall}" />
    <Setter Property="Height" Value="{StaticResource IconSmall}" />
  </Style>
  <Style Selector="PathIcon.large">
    <Setter Property="Width" Value="{StaticResource IconLarge}" />
    <Setter Property="Height" Value="{StaticResource IconLarge}" />
  </Style>

  <!-- The nav rail collapsed to icons (descendant selectors cannot live in a control theme). -->
  <Style Selector="ctl|NavRail:collapsed TextBlock#Label">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ctl|NavRail:collapsed ctl|Badge#Count">
    <Setter Property="IsDot" Value="True" />
    <Setter Property="Margin" Value="-4,-22,0,0" />
  </Style>
  <Style Selector="ctl|NavRail:collapsed ListBoxItem Grid">
    <Setter Property="Margin" Value="22,0,0,0" />
  </Style>

  <!-- Motion: the tab flag slides (removed under reduced motion below). -->
  <Style Selector="ctl|SkewBorder.tab-indicator">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionTab}" Easing="CubicEaseOut" />
        <DoubleTransition Property="Width" Duration="{StaticResource MotionTab}" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(TopLevel):not(.reduced-motion) ctl|Spinner">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Reduced motion (spec 01 section 10): a class on the top level removes transitions and spins. -->
  <Style Selector=":is(TopLevel).reduced-motion ctl|SkewBorder.tab-indicator">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- W/L strip: W filled positive, L outlined negative; the letter is always there. -->
  <Style Selector="Border.wl.win">
    <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
  </Style>
  <Style Selector="Border.wl.win TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PureBlackBrush}" />
  </Style>
  <Style Selector="Border.wl.loss">
    <Setter Property="BorderBrush" Value="{DynamicResource NegativeBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Border.wl.loss TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
  </Style>

  <!-- Bracket: the user's path carries the accent stripe. -->
  <Style Selector="Border.series.user">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>

  <!-- Calendar day cards. -->
  <Style Selector="Button.daycard">
    <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
  </Style>
  <Style Selector="Button.daycard.out">
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Button.daycard.game:pointerover">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
  </Style>
  <Style Selector="Button.daycard.today">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.daycard.today /template/ Border#PART_Hover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,3,0,0" />
  </Style>
  <Style Selector="Button.daycard:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.daycard.out:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Toasts: a stripe and icon in the kind's colour. -->
  <Style Selector="Border.toast Border.toast-stripe">
    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
  </Style>
  <Style Selector="Border.toast PathIcon.toast-icon">
    <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
  </Style>
  <Style Selector="Border.toast.success Border.toast-stripe">
    <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
  </Style>
  <Style Selector="Border.toast.success PathIcon.toast-icon">
    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
  </Style>
  <Style Selector="Border.toast.warning Border.toast-stripe">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Border.toast.warning PathIcon.toast-icon">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Border.toast.error Border.toast-stripe">
    <Setter Property="Background" Value="{DynamicResource NegativeBrush}" />
  </Style>
  <Style Selector="Border.toast.error PathIcon.toast-icon">
    <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
  </Style>

  <!-- Skeleton bones shimmer; still under reduced motion. -->
  <Style Selector=":is(Control).bone">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Border.bone">
    <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
  </Style>
  <Style Selector="Ellipse.bone">
    <Setter Property="Fill" Value="{StaticResource Surface3Brush}" />
  </Style>
  <Style Selector=":is(TopLevel):not(.reduced-motion) Panel.skeleton">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.55" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Reduced motion: progress bars stop sweeping (the step text still says what is happening). -->
  <Style Selector=":is(TopLevel).reduced-motion ProgressBar">
    <Setter Property="IsIndeterminate" Value="False" />
  </Style>

  <!-- Data table rows: zebra, the user's own row, the sorted header. -->
  <Style Selector="ListBox.datatable ListBoxItem:nth-child(2n) DockPanel">
    <Setter Property="Background" Value="{StaticResource ZebraBrush}" />
  </Style>
  <Style Selector="ListBox.datatable DockPanel.highlight">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="TextBlock.label-caps.sorted">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- Stock text inputs: legible placeholders and an outside-weight focus border. -->
  <Style Selector="TextBox">
    <Setter Property="PlaceholderForeground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox.force-focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Position familiarity chips on the profile: stronger fill for stronger familiarity. -->
  <Style Selector="Border.familiarity">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
  </Style>
  <Style Selector="Border.familiarity.competent">
    <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
  </Style>
  <Style Selector="Border.familiarity.accomplished">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.familiarity.natural">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.familiarity.natural TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- Size-only helpers for screens not yet rebuilt (they replaced literal FontSize values). -->
  <Style Selector="TextBlock.size-caption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
  </Style>
  <Style Selector="TextBlock.size-table">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTable}" />
  </Style>
  <Style Selector="TextBlock.size-body">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>
  <Style Selector="TextBlock.size-h3">
    <Setter Property="FontSize" Value="{StaticResource FontSizeH3}" />
  </Style>
  <Style Selector="TextBlock.size-stat-m">
    <Setter Property="FontSize" Value="{StaticResource FontSizeStatM}" />
  </Style>
  <Style Selector="TextBlock.size-h1">
    <Setter Property="FontSize" Value="{StaticResource FontSizeH1}" />
  </Style>
</Styles>
