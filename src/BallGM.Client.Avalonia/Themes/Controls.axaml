<!--
  Style classes: the vocabulary views are written in. A view says Classes="section" or
  Classes="panel", never FontSize/Opacity/Background literals, so the whole client restyles here.

  Text:    display, h1, h2, h3, section (a block's heading), eyebrow (a field or stat label),
           body, dim, faint, num (Barlow Condensed, tabular), code, good/warn/bad/accent
  Boxes:   panel, card, callout, stat, pill, ovr (colour set by OverallTierConverter), crest
  Season:  ribbon-* (the season ribbon), Button.daycell (month grid), matchup, form, badge; Button.cardbtn, Button.scrim + Border.sheet (the game sheet), Button.meeting
  Tables:  Grid.thead (header row), ItemsControl.table (zebra rows), ListBox.table
  Buttons: default (ghost), primary
  Nav:     ListBox.nav

  Case: everything is sentence case. The only capitals are the team name in the identity band,
  position codes, and stat abbreviations (PPG, FGA), which are capitals in the sport itself.
-->
<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg0Brush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Type scale. Headings are Barlow Condensed: the jersey-lettering voice, upright, never italic. -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="38" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A block's heading: condensed, full-strength text, sentence case. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <!-- A field or stat label: small, dim, sentence case. -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="TextBlock.eyebrow.accent">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.tiny">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <!-- A rule code: kept visible for explainability, set quietly after the sentence it codes. -->
  <Style Selector="TextBlock.code">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Every figure: condensed, tabular, a size up so condensed digits read at table density. -->
  <Style Selector="TextBlock.num">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
  </Style>
  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
  </Style>

  <!-- Boxes. Panels are the one boxed surface; most content sits straight on the floor. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.card.accent">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <!-- An explanation the GM should read: a paint rule down the left on the panel surface. -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.callout.bad">
    <Setter Property="Background" Value="{StaticResource BadSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
  </Style>
  <Style Selector="Border.callout.warn">
    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
  </Style>
  <!-- A headline figure: label over a large condensed number, separated by a hairline, not a card. -->
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="0,2,28,2" />
    <Setter Property="MinWidth" Value="140" />
  </Style>
  <Style Selector="Border.stat.accent">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
  </Style>
  <Style Selector="Border.stat TextBlock.value">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pill.bad">
    <Setter Property="Background" Value="{StaticResource BadPillBrush}" />
  </Style>
  <Style Selector="Border.pill.bad TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
  </Style>
  <!-- Overall rating: a square chip like a jersey number. Colour from OverallTierConverter. -->
  <Style Selector="Border.ovr">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ovr TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{StaticResource Bg0Brush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ovr.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Border.ovr.small TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- Player face: a round frame on the raised surface, so a missing portrait still reads as a slot. -->
  <Style Selector="Border.face">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.face.large">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <!-- Team crest for a pack without logos: the team's initials on a paint plate. -->
  <Style Selector="Border.crest">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
  </Style>
  <Style Selector="Border.crest TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A short paint tick that marks a heading as the current one. -->
  <Style Selector="Border.slash">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Tables. A header row is a Grid.thead; rows are an ItemsControl.table, zebra-striped. -->
  <Style Selector="Grid.thead">
    <Setter Property="Margin" Value="10,0,10,6" />
  </Style>
  <Style Selector="Grid.thead TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
  </Style>
  <!-- A sortable column header: reads as header text, lights up on hover. -->
  <Style Selector="Button.th">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.th:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <!-- A whole table row that opens something: no button chrome, the row's own hover shows it. -->
  <Style Selector="Button.rowbtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.rowbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.rowbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
  </Style>
  <!-- Attribute bar on the player profile; the fill colour comes from the rating tier. -->
  <Style Selector="ProgressBar.attr">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    <Setter Property="Margin" Value="0,5,0,0" />
  </Style>
  <Style Selector="ItemsControl.table > ContentPresenter">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ItemsControl.table > ContentPresenter:nth-child(2n+1)">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
  </Style>
  <Style Selector="ItemsControl.table > ContentPresenter:pointerover">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
  </Style>

  <!-- The viewed team's own line in a league table: a paint rule at the left edge. -->
  <Style Selector="ItemsControl.table Grid.viewed">
    <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
  </Style>
  <Style Selector="ItemsControl.table Grid.viewed > TextBlock:nth-child(1)">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Lists. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ListBox ListBoxItem">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <!-- Row templates inside lists: text lines up with the rating badge's centre. -->
  <Style Selector="ListBoxItem Grid > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A table that selects: rows flush, zebra, the selected row carrying a paint rule. -->
  <Style Selector="ListBox.table">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:nth-child(2n+1)">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem Grid > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A row of choices drawn as cells (the depth strip): hairline-separated, paint rule on the chosen one. -->
  <Style Selector="ListBox.strip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.strip ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
  </Style>
  <Style Selector="ListBox.strip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Sidebar navigation. The open screen gets a paint rule and the raised surface. -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.navgroup">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    <Setter Property="Margin" Value="23,14,0,4" />
  </Style>

  <!-- Buttons: ghost by default, primary (paint) for the one action a screen is about. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bg4Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TextFaintBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
  </Style>

  <!-- The season ribbon: every day of the season in one strip. Phases are alternating bands, the
       current one tinted in paint; a win is a bar above the centre line, a loss one below it. -->
  <Style Selector="Border.ribbon-phase">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
  </Style>
  <Style Selector="Border.ribbon-phase.alt">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
  </Style>
  <Style Selector="Border.ribbon-phase.current">
    <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
  </Style>
  <Style Selector="Border.ribbon-label">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="6,4,4,0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.ribbon-label.current">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.ribbon-win">
    <Setter Property="Background" Value="{StaticResource GoodBrush}" />
    <Setter Property="Margin" Value="0.5,0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Border.ribbon-loss">
    <Setter Property="Background" Value="{StaticResource BadBrush}" />
    <Setter Property="Margin" Value="0.5,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.ribbon-tick">
    <Setter Property="Background" Value="{StaticResource TextFaintBrush}" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="0.5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ribbon-today">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="MinWidth" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- The month grid: a cell per day. A game day is a raised square with a result rule down its
       left edge; a day outside the season is bare floor; today is ringed in paint. -->
  <Style Selector="Button.daycell">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Height" Value="74" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.daycell.game">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
  </Style>
  <Style Selector="Button.daycell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TextFaintBrush}" />
  </Style>
  <Style Selector="Button.daycell:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.daycell.off:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.daycell.today">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.daycell.today:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.daycell.today:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.result-rule">
    <Setter Property="Width" Value="3" />
    <Setter Property="Background" Value="{StaticResource Bg4Brush}" />
  </Style>
  <Style Selector="Border.result-rule.win">
    <Setter Property="Background" Value="{StaticResource GoodBrush}" />
  </Style>
  <Style Selector="Border.result-rule.loss">
    <Setter Property="Background" Value="{StaticResource BadBrush}" />
  </Style>

  <!-- A fixture still to play, washed in the opponent's colour; home games ruled in paint. -->
  <Style Selector="Border.matchup">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bg4Brush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.matchup.home">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.warn TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
  </Style>
  <!-- A team badge: its pack logo, or a plate in its own colour (TeamShadeConverter) with its initials. -->
  <Style Selector="Panel.badge">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>
  <Style Selector="Panel.badge.small">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Border.badge-plate">
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Panel.badge.small Border.badge-plate">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.badge-plate TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.badge Image">
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Panel.badge.large">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
  </Style>
  <Style Selector="Panel.badge.large Border.badge-plate">
    <Setter Property="CornerRadius" Value="32" />
  </Style>
  <Style Selector="Panel.badge.large Border.badge-plate TextBlock">
    <Setter Property="FontSize" Value="20" />
  </Style>

  <!-- A card that opens something: the card draws itself, the button only adds hover and press. -->
  <Style Selector="Button.cardbtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.cardbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.cardbtn:pointerover Border.matchup">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
  </Style>
  <Style Selector="Button.cardbtn:pressed Border.matchup">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
  </Style>

  <!-- A sheet over the screen: the scrim behind closes it, the sheet itself is a raised panel. -->
  <Style Selector="Button.scrim">
    <Setter Property="Background" Value="{StaticResource ScrimBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.scrim:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.scrim:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ScrimBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bg4Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="MaxWidth" Value="1120" />
    <Setter Property="Margin" Value="24,16" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 16 48 0 #99000000" />
  </Style>
  <!-- One meeting in a season series: a small raised tile. -->
  <Style Selector="Button.meeting">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- One result in a form strip. -->
  <Style Selector="Border.form">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource BadPillBrush}" />
  </Style>
  <Style Selector="Border.form.win">
    <Setter Property="Background" Value="{StaticResource GoodSoftBrush}" />
  </Style>
  <Style Selector="Border.form TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.form.win TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
  </Style>

  <!-- Profile tabs: condensed labels with a paint underline on the open one. -->
  <Style Selector="TabControl.profile TabItem">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0,6,26,6" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="TabControl.profile TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Inputs sit on the raised surface. -->
  <Style Selector="ComboBox, TextBox, NumericUpDown">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bg4Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
  </Style>
</Styles>
