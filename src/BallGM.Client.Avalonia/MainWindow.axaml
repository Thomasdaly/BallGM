<Window
  x:Class="BallGM.Client.Avalonia.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:app="clr-namespace:BallGM.Application.Leagues;assembly=BallGM.Application"
  xmlns:views="clr-namespace:BallGM.Client.Avalonia.Views"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  Title="BallGM"
  Width="1120"
  Height="720"
  MinWidth="900"
  MinHeight="560"
  x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,*" Margin="20" RowSpacing="16">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding LeagueName}" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{Binding LeagueSubtitle}" Opacity="0.7" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLeague}">
        <TextBlock Text="Team" VerticalAlignment="Center" Opacity="0.7" />
        <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" MinWidth="260">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="app:TeamSummary">
              <TextBlock Text="{Binding TeamName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <Border
      Grid.Row="1"
      IsVisible="{Binding !HasLeague}"
      Padding="16"
      CornerRadius="4"
      Background="#40903030"
      VerticalAlignment="Top">
      <StackPanel Spacing="8">
        <TextBlock Text="Load errors" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding LoadErrors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="160,*" ColumnSpacing="20" IsVisible="{Binding HasLeague}">
      <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" />

      <ContentControl Grid.Column="1" Content="{Binding CurrentScreen}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:RosterViewModel">
            <views:RosterView />
          </DataTemplate>
          <DataTemplate DataType="vm:CapSheetViewModel">
            <views:CapSheetView />
          </DataTemplate>
          <DataTemplate DataType="vm:PickBoardViewModel">
            <views:PickBoardView />
          </DataTemplate>
          <DataTemplate DataType="vm:TradeProposalViewModel">
            <views:TradeProposalView />
          </DataTemplate>
          <DataTemplate DataType="vm:FreeAgencyViewModel">
            <views:FreeAgencyView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
