<Window
  x:Class="BallGM.Client.Avalonia.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:ctl="clr-namespace:BallGM.Client.Avalonia.Controls"
  xmlns:views="clr-namespace:BallGM.Client.Avalonia.Views"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  Title="BallGM"
  Width="1600"
  Height="900"
  MinWidth="1280"
  MinHeight="720"
  Background="{StaticResource CanvasBrush}"
  x:DataType="vm:MainWindowViewModel">
  <LayoutTransformControl Name="ScaleHost">
    <ctl:DialogHost Name="Dialogs" Request="{Binding Dialog}">
      <Panel>
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- (A) Header band: the user's team colour fading into the canvas. -->
          <Panel Name="HeaderBand" Height="{StaticResource HeaderBandHeight}" Background="{StaticResource CanvasBrush}">
            <Grid ColumnDefinitions="2*,3*" IsHitTestVisible="False">
              <Border Background="{DynamicResource TeamGradientBrush}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space16}" Margin="{StaticResource PadH16}" IsVisible="{Binding HasLeague}">
              <ctl:TeamLogo TeamId="{Binding UserTeamId}" TeamName="{Binding UserTeamName}" Size="40" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Name="HeaderTeam" Text="{Binding UserTeamName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="h3 trim on-primary" ToolTip.Tip="{Binding UserTeamName}" />
                <TextBlock Text="{Binding HeaderRecordLine}" Classes="caps num on-primary" />
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource Space4}" VerticalAlignment="Center">
                <Button Classes="icon" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Back (Alt+Left)" AutomationProperties.Name="Back">
                  <PathIcon Data="{StaticResource Icon.Back}" />
                </Button>
                <Button Classes="icon" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
                  <PathIcon Data="{StaticResource Icon.Forward}" />
                </Button>
              </StackPanel>
              <Button Name="SearchButton" Grid.Column="4" Classes="secondary" Command="{Binding OpenSearchCommand}" VerticalAlignment="Center" ToolTip.Tip="Search players and teams (Ctrl+K)" AutomationProperties.Name="Search">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                  <PathIcon Data="{StaticResource Icon.Search}" Classes="small" />
                  <TextBlock Name="SearchLabel" Text="Search" Classes="body" />
                  <TextBlock Name="SearchHint" Text="CTRL+K" Classes="label-caps" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding HeaderDate}" Classes="h3 num" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding HeaderPhase}" Classes="label-caps" HorizontalAlignment="Right" />
              </StackPanel>
              <ctl:ContinueButton
                Name="Continue"
                Grid.Column="6"
                VerticalAlignment="Center"
                State="{Binding ContinueState}"
                Label="{Binding ContinueLabel}"
                Subtitle="{Binding ContinueSubtitle}"
                Command="{Binding ContinueCommand}"
                Options="{Binding ContinueOptions}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" Margin="{StaticResource PadH24}" VerticalAlignment="Center" IsVisible="{Binding !HasLeague}">
              <PathIcon Data="{StaticResource Icon.Ball}" Classes="large" />
              <TextBlock Text="BALLGM" Classes="h2" VerticalAlignment="Center" />
            </StackPanel>
          </Panel>

          <!-- Body: nav rail and the page area. -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" IsVisible="{Binding HasLeague}">
            <Border Name="Rail" Width="{StaticResource NavRailExpandedWidth}" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="{StaticResource HairlineRight}">
              <DockPanel>
                <Button Name="CollapseRail" DockPanel.Dock="Bottom" Classes="ghost small" Margin="{StaticResource Pad8}" HorizontalAlignment="Left" Click="OnToggleRail" ToolTip.Tip="Collapse or expand the menu" AutomationProperties.Name="Collapse or expand the menu">
                  <PathIcon Data="{StaticResource Icon.Collapse}" Classes="small" />
                </Button>
                <ctl:NavRail Name="Nav" ItemsSource="{Binding NavEntries}" SelectedItem="{Binding SelectedNavEntry}" Margin="{StaticResource PadV8}" />
              </DockPanel>
            </Border>
            <Panel Grid.Column="1" Background="{StaticResource CanvasGradientBrush}">
              <DockPanel Name="Page" Margin="{StaticResource PagePadding}">
                <ctl:PageHeader DockPanel.Dock="Top" Title="{Binding PageTitle}" Margin="{StaticResource GapBottom16}">
                  <ctl:PageHeader.Breadcrumb>
                    <ctl:Breadcrumb Name="Crumbs" Items="{Binding Breadcrumb}" />
                  </ctl:PageHeader.Breadcrumb>
                </ctl:PageHeader>
                <TransitioningContentControl Name="Screen" Content="{Binding CurrentScreen}">
                  <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RosterViewModel">
                      <views:RosterView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:CapSheetViewModel">
                      <views:CapSheetView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:PickBoardViewModel">
                      <views:PickBoardView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:TradeProposalViewModel">
                      <views:TradeProposalView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:FreeAgencyBoardViewModel">
                      <views:FreeAgencyBoardView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:FreeAgencyViewModel">
                      <views:FreeAgencyView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SeasonViewModel">
                      <views:SeasonView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:FrontOfficeViewModel">
                      <views:FrontOfficeView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:LeadersViewModel">
                      <views:LeadersView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:HistoryViewModel">
                      <views:HistoryView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ContractsViewModel">
                      <views:ContractsView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:PlayerProfileViewModel">
                      <views:PlayerProfileView />
                    </DataTemplate>
                  </TransitioningContentControl.DataTemplates>
                </TransitioningContentControl>
              </DockPanel>
              <ctl:ProgressOverlay IsActive="{Binding IsBusy}" Title="Simulating" StepText="{Binding BusyStep}" />
            </Panel>
          </Grid>

          <!-- League failed to load (S37): the shell still opens, so the reason is visible. -->
          <ctl:ErrorState
            Grid.Row="1"
            IsVisible="{Binding !HasLeague}"
            Headline="{Binding LeagueName}"
            Message="{Binding LoadErrorText}"
            Details="{Binding LoadErrorText}" />

          <!-- (D) Ticker. -->
          <ctl:Ticker Name="TickerStrip" Grid.Row="2" Items="{Binding TickerItems}" IsVisible="{Binding ShowTicker}" />
        </Grid>

        <!-- Toasts: top right, under the header. -->
        <ctl:ToastHost
          ItemsSource="{Binding Toasts.Toasts}"
          ItemTemplate="{StaticResource ToastTemplate}"
          DismissCommand="{Binding Toasts.DismissCommand}"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Margin="0,72,16,0" />

        <!-- Global search (S28): a command palette over a scrim. -->
        <Panel Name="SearchLayer" Background="{StaticResource ScrimBrush}" IsVisible="{Binding IsSearchOpen}">
          <Border Background="{StaticResource Surface2Brush}" CornerRadius="{StaticResource RadiusCard}" Width="640" MaxHeight="560" VerticalAlignment="Top" Margin="0,96,0,0" BoxShadow="{StaticResource ShadowFloating}" Padding="{StaticResource Pad16}">
            <DockPanel>
              <ctl:SearchBox Name="SearchInput" DockPanel.Dock="Top" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search players and teams" Margin="{StaticResource GapBottom12}" />
              <TextBlock DockPanel.Dock="Bottom" Text="ENTER OPENS · ESC CLOSES · ↑↓ MOVE" Classes="label-caps" Margin="{StaticResource GapTop8}" />
              <Panel>
                <ListBox Name="SearchList" ItemsSource="{Binding SearchResults}" IsVisible="{Binding HasSearchResults}" Background="{x:Null}" ItemContainerTheme="{StaticResource TableRowItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResult">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space12}" Margin="{StaticResource PadH8}">
                        <Panel Width="32" Height="32" VerticalAlignment="Center">
                          <ctl:PlayerHeadshot PlayerId="{Binding Id}" PlayerName="{Binding Name}" Size="Small" IsVisible="{Binding IsPlayer}" />
                          <ctl:TeamLogo TeamId="{Binding Id}" TeamName="{Binding Name}" Size="32" IsVisible="{Binding IsTeam}" />
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Classes="body-strong trim" />
                          <TextBlock Text="{Binding Detail}" Classes="caption trim" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Group}" Classes="label-caps" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding SearchEmptyMessage}" Classes="body secondary" IsVisible="{Binding !HasSearchResults}" Margin="{StaticResource PadV16}" HorizontalAlignment="Center" />
              </Panel>
            </DockPanel>
          </Border>
        </Panel>
      </Panel>
    </ctl:DialogHost>
  </LayoutTransformControl>
</Window>
