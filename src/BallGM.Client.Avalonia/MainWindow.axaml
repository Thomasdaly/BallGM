<Window
  x:Class="BallGM.Client.Avalonia.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:app="clr-namespace:BallGM.Application.Leagues;assembly=BallGM.Application"
  xmlns:conv="clr-namespace:BallGM.Client.Avalonia.Converters"
  xmlns:views="clr-namespace:BallGM.Client.Avalonia.Views"
  xmlns:vm="clr-namespace:BallGM.Client.Avalonia.ViewModels"
  Title="BallGM"
  Width="1360"
  Height="860"
  MinWidth="1080"
  MinHeight="640"
  x:DataType="vm:MainWindowViewModel">
  <Grid ColumnDefinitions="228,*">

    <!-- Sidebar: wordmark, navigation, league footer. -->
    <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="22,26,20,26">
          <Border Classes="slash" Height="26" Width="7" />
          <TextBlock Text="BALLGM" Classes="display" FontSize="26" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="22,16,20,22">
          <TextBlock Text="LEAGUE" Classes="eyebrow" FontSize="10" />
          <TextBlock Text="{Binding LeagueName}" Classes="small strong" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="MANAGE" Classes="eyebrow" FontSize="10" Margin="22,0,0,4" />
          <ListBox x:Name="Nav" Classes="nav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon
                    Data="{Binding Converter={x:Static conv:SectionIconConverter.Instance}}"
                    Width="16"
                    Height="16" />
                  <TextBlock
                    Text="{Binding Converter={x:Static conv:UpperCaseConverter.Instance}}"
                    FontSize="12"
                    FontWeight="Bold"
                    LetterSpacing="0.8"
                    VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <!-- Identity banner: crest, team, league line, team picker. -->
      <Border Background="{StaticResource BannerBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" Margin="32,22,32,20">
          <!-- The pack's logo when it supplies one; otherwise a crest drawn from the team's initials. -->
          <Panel IsVisible="{Binding HasLeague}" Width="64" Height="56" VerticalAlignment="Center">
            <Border Classes="crest" IsVisible="{Binding SelectedTeam.LogoPath, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}">
              <TextBlock Text="{Binding SelectedTeam.TeamName, Converter={x:Static conv:TeamInitialsConverter.Instance}, FallbackValue=''}" />
            </Border>
            <Image
              Source="{Binding SelectedTeam.LogoPath, Converter={x:Static conv:ImagePathConverter.Instance}, FallbackValue={x:Null}}"
              IsVisible="{Binding SelectedTeam.LogoPath, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Stretch="Uniform" />
          </Panel>

          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding HasLeague}">
            <TextBlock Text="{Binding LeagueSubtitle, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="eyebrow accent" FontSize="10" TextTrimming="CharacterEllipsis" />
            <TextBlock
              Text="{Binding SelectedTeam.TeamName, Converter={x:Static conv:UpperCaseConverter.Instance}, FallbackValue=''}"
              Classes="display"
              TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding SelectedTeamDetail}" Classes="dim small" VerticalAlignment="Center" />
              <Border Classes="pill bad" IsVisible="{Binding HasAlerts}">
                <TextBlock Text="{Binding AlertLine, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding !HasLeague}">
            <TextBlock Text="{Binding LeagueName, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="display" />
            <TextBlock Text="{Binding LeagueSubtitle}" Classes="dim" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasLeague}">
            <TextBlock Text="VIEWING TEAM" Classes="eyebrow" FontSize="10" />
            <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" MinWidth="260">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="app:TeamSummary">
                  <TextBlock Text="{Binding TeamName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Load failure: the shell still opens so the reason is visible. -->
      <Border Grid.Row="1" Classes="callout bad" Margin="32,24" VerticalAlignment="Top" IsVisible="{Binding !HasLeague}">
        <StackPanel Spacing="8">
          <TextBlock Text="LOAD ERRORS" Classes="eyebrow" />
          <ItemsControl ItemsSource="{Binding LoadErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <DockPanel Grid.Row="1" Margin="32,22,32,24" IsVisible="{Binding HasLeague}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
        <Border Classes="slash" Height="20" Width="6" />
        <TextBlock Text="{Binding SelectedSection, Converter={x:Static conv:UpperCaseConverter.Instance}}" Classes="h1" />
      </StackPanel>
      <ContentControl Content="{Binding CurrentScreen}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:RosterViewModel">
            <views:RosterView />
          </DataTemplate>
          <DataTemplate DataType="vm:CapSheetViewModel">
            <views:CapSheetView />
          </DataTemplate>
          <DataTemplate DataType="vm:PickBoardViewModel">
            <views:PickBoardView />
          </DataTemplate>
          <DataTemplate DataType="vm:TradeProposalViewModel">
            <views:TradeProposalView />
          </DataTemplate>
          <DataTemplate DataType="vm:FreeAgencyBoardViewModel">
            <views:FreeAgencyBoardView />
          </DataTemplate>
          <DataTemplate DataType="vm:FreeAgencyViewModel">
            <views:FreeAgencyView />
          </DataTemplate>
          <DataTemplate DataType="vm:SeasonViewModel">
            <views:SeasonView />
          </DataTemplate>
          <DataTemplate DataType="vm:FrontOfficeViewModel">
            <views:FrontOfficeView />
          </DataTemplate>
          <DataTemplate DataType="vm:ContractsViewModel">
            <views:ContractsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
