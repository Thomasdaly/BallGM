<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../data/rulesets/*.json" LinkBase="data\rulesets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/BallGM.Application/BallGM.Application.csproj" />
    <ProjectReference Include="../../../src/BallGM.Domain/BallGM.Domain.csproj" />
    <ProjectReference Include="../../../src/BallGM.Infrastructure/BallGM.Infrastructure.csproj" />
    <ProjectReference Include="../../../src/BallGM.Mods/BallGM.Mods.csproj" />
    <ProjectReference Include="../../../src/BallGM.Rules/BallGM.Rules.csproj" />
    <ProjectReference Include="../../../src/BallGM.Simulation/BallGM.Simulation.csproj" />
  </ItemGroup>

</Project>
