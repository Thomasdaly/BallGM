<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local tuning harness for league packs. Deliberately not in BallGM.slnx: it reads packs from
       local-packs/, which never ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/BallGM.Application/BallGM.Application.csproj" />
    <ProjectReference Include="../../../src/BallGM.Infrastructure/BallGM.Infrastructure.csproj" />
  </ItemGroup>

</Project>
